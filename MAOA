# Хранилище счётчиков (в реальном проекте используйте БД)
counters_db = {}

@flask_app.route('/')
def index():
    """Главная страница Mini App"""
    return render_template_string(HTML_TEMPLATE)

@flask_app.route('/api/counter', methods=['POST'])
def update_counter():
    """API для обновления счётчика"""
    try:
        data = request.get_json()
        if data:
            user_id = str(data.get('user_id', 'anonymous'))
            counter = data.get('counter', 0)
            action = data.get('action', 'update')
            
            counters_db[user_id] = counter
            
            logger.info(f"Пользователь {user_id} ({data.get('username')}): {action} -> {counter}")
            
            return jsonify({
                'status': 'ok',
                'counter': counter,
                'action': action,
                'message': f'Счётчик обновлён: {counter}'
            })
    except Exception as e:
        logger.error(f"Ошибка API: {e}")
        return jsonify({'status': 'error', 'message': str(e)}), 400

@flask_app.route('/api/get-counter')
def get_counter():
    """Получение значения счётчика"""
    user_id = request.args.get('user_id', 'anonymous')
    counter = counters_db.get(user_id, 0)
    return jsonify({'counter': counter})

@flask_app.route('/api/send-to-bot', methods=['POST'])
def send_to_bot():
    """Получение данных от Mini App для бота"""
    try:
        data = request.get_json()
        logger.info(f"📤 Данные от Mini App: {json.dumps(data, indent=2)}")
        return jsonify({'status': 'ok', 'message': 'Данные получены'})
    except Exception as e:
        return jsonify({'status': 'error', 'message': str(e)}), 400

@flask_app.route('/health')
def health():
    """Проверка работоспособности"""
    return jsonify({
        'status': 'ok',
        'service': 'Telegram Mini App + Bot',
        'active_counters': len(counters_db)
    })

