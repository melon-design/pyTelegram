# ---------- ОБЩАЯ СТАВКА ----------
@dp.callback_query(lambda c: c.data.startswith("game_"))
async def game_bet(c: CallbackQuery, state: FSMContext):
    game = c.data.split("_")[1]
    await state.update_data(game=game)
    await state.set_state(GState.bet)
    await c.message.edit_text("💰 Введи сумму ставки в BOLT:", reply_markup=kb_cancel(), parse_mode="Markdown")
    await c.answer()

@dp.message(GState.bet)
async def process_bet(m: types.Message, state: FSMContext):
    if not m.text.isdigit() or int(m.text) <= 0:
        await m.answer("❌ Введи число > 0:")
        return
    bet = int(m.text)
    balance = get_balance(m.from_user.id)
    if bet > balance:
        await m.answer(f"❌ Недостаточно. Баланс: {balance} BOLT")
        return
    data = await state.get_data()
    game = data.get("game")
    save_bet(m.from_user.id, game, bet)
    await state.clear()
    if game == "mines":
        await m.answer("💣 *Мины*\n5 мин на поле 5x5\nКаждое нажатие +0.3 к множителю", reply_markup=kb_mines(), parse_mode="Markdown")
    elif game == "roulette":
        await m.answer("🎡 *Рулетка*\n🔴 Красное (x2) | ⚫ Чёрное (x2) | 🟢 Зелёное (x10)\nЗелёное — очень редкий выигрыш!", reply_markup=kb_roulette(), parse_mode="Markdown")
    elif game == "tower":
        await m.answer("🏗️ *Башня*\n8 этажей, множитель растёт с каждым этажом.\nРиск падения увеличивается.", reply_markup=kb_tower(), parse_mode="Markdown")

# ====================== МИНЫ ======================
@dp.callback_query(lambda c: c.data == "mines_start")
async def mines_start(c: CallbackQuery, state: FSMContext):
    uid = c.from_user.id
    bet_data = get_bet(uid)
    if not bet_data or bet_data["game"] != "mines":
        await c.answer("❌ Сначала введи ставку!", show_alert=True)
        return
    bet = bet_data["bet"]
    if bet > get_balance(uid):
        await c.message.edit_text("❌ Недостаточно средств.", reply_markup=kb_games())
        del_bet(uid)
        await c.answer()
        return
    
    field = [["⬜" for _ in range(5)] for _ in range(5)]
    opened = [False] * 25
    clicks = 0
    multiplier = 1.0
    
    mine_positions = set()
    while len(mine_positions) < 5:
        mine_positions.add(random.randint(0, 24))
    
    await state.update_data(
        game="mines",
        bet=bet,
        field=field,
        opened=opened,
        mine_positions=list(mine_positions),
        clicks=clicks,
        multiplier=multiplier,
        game_over=False
    )
    
    await c.message.edit_text(
        f"💣 *Мины*\n\n"
        f"Ставка: *{bet} BOLT*\n"
        f"Нажми на клетку, чтобы открыть её.\n"
        f"Попадание на мину — проигрыш.\n"
        f"Множитель: x{multiplier:.1f} (+0.3 за нажатие)\n\n"
        f"Выбери клетку:",
        reply_markup=kb_mines_field(field, opened, multiplier, clicks),
        parse_mode="Markdown"
    )
    await c.answer()

@dp.callback_query(lambda c: c.data.startswith("m_") and c.data != "m_cash")
async def mines_cell(c: CallbackQuery, state: FSMContext):
    cell = int(c.data.split("_")[1])
    uid = c.from_user.id
    data = await state.get_data()
    
    if data.get("game_over", False):
        await c.answer("⏳ Игра уже завершена!", show_alert=True)
        return
    
    field = data.get("field", [["⬜" for _ in range(5)] for _ in range(5)])
    opened = data.get("opened", [False] * 25)
    mine_positions = data.get("mine_positions", [])
    bet = data.get("bet", 0)
    clicks = data.get("clicks", 0)
    multiplier = data.get("multiplier", 1.0)
    
    if opened[cell]:
        await c.answer("❌ Эта клетка уже открыта!", show_alert=True)
        return
    
    row, col = divmod(cell, 5)
    opened[cell] = True
    
    if cell in mine_positions:
        field[row][col] = "💣"
        for pos in mine_positions:
            r, c2 = divmod(pos, 5)
            if field[r][c2] != "💣":
                field[r][c2] = "💣"
        
        upd_balance(uid, -bet)
        add_history(uid, "💣 Мины", -bet, f"Проигрыш (x{multiplier:.1f})")
        
        await c.message.edit_text(
            f"💣 *БАХ!* Ты попал на мину!\n\n"
            f"Проигрыш: *-{bet} BOLT*\n"
            f"Множитель был: x{multiplier:.1f}",
            reply_markup=kb_mines_result(field),
            parse_mode="Markdown"
        )
        await state.update_data(game_over=True)
        del_bet(uid)
        await c.answer()
        return
    
    field[row][col] = "✅"
    clicks += 1
    multiplier = 1.0 + (clicks * 0.3)
    
    await state.update_data(
        field=field,
        opened=opened,
        clicks=clicks,
        multiplier=multiplier
    )
    
    if clicks >= 20:
        win = int(bet * multiplier)
        upd_balance(uid, win)
        add_history(uid, "💣 Мины", win, f"Выигрыш (x{multiplier:.1f})")
        
        for pos in mine_positions:
            r, c2 = divmod(pos, 5)
            if field[r][c2] != "💣":
                field[r][c2] = "💣"
        
        await c.message.edit_text(
            f"🎉 *ПОБЕДА!* Ты открыл все клетки!\n\n"
            f"Множитель: x{multiplier:.1f}\n"
            f"Выигрыш: *+{win} BOLT*",
            reply_markup=kb_mines_result(field),
            parse_mode="Markdown"
        )
        await state.update_data(game_over=True)
        del_bet(uid)
        await c.answer()
        return
    
    await c.message.edit_text(
        f"💣 *Мины*\n\n"
        f"Ставка: *{bet} BOLT*\n"
        f"Открыто: {clicks}/20\n"
        f"Множитель: x{multiplier:.1f} (+0.3 за нажатие)\n\n"
        f"Выбери клетку:",
        reply_markup=kb_mines_field(field, opened, multiplier, clicks),
        parse_mode="Markdown"
    )
    await c.answer()

@dp.callback_query(lambda c: c.data == "m_cash")
async def mines_cash(c: CallbackQuery, state: FSMContext):
    uid = c.from_user.id
    data = await state.get_data()
    
    if data.get("game_over", False):
        await c.answer("⏳ Игра уже завершена!", show_alert=True)
        return
    
    bet = data.get("bet", 0)
    multiplier = data.get("multiplier", 1.0)
    clicks = data.get("clicks", 0)
    field = data.get("field", [["⬜" for _ in range(5)] for _ in range(5)])
    mine_positions = data.get("mine_positions", [])
    
    if clicks == 0:
        await c.answer("❌ Ты ещё не открыл ни одной клетки!", show_alert=True)
        return
    
    win = int(bet * multiplier)
    upd_balance(uid, win)
    add_history(uid, "💣 Мины", win, f"Забрал (x{multiplier:.1f})")
    
    for pos in mine_positions:
        r, c2 = divmod(pos, 5)
        if field[r][c2] != "💣":
            field[r][c2] = "💣"
    
    await c.message.edit_text(
        f"💰 *Ты забрал выигрыш!*\n\n"
        f"Множитель: x{multiplier:.1f}\n"
        f"Выигрыш: *+{win} BOLT*",
        reply_markup=kb_mines_result(field),
        parse_mode="Markdown"
    )
    await state.update_data(game_over=True)
    del_bet(uid)
    await c.answer()

# ====================== РУЛЕТКА ======================
@dp.callback_query(lambda c: c.data.startswith("roulette_"))
async def roulette_play(c: CallbackQuery):
    color = c.data.split("_")[1]
    colors = {"red": "🔴", "black": "⚫", "green": "🟢"}
    mults = {"red": 2, "black": 2, "green": 10}
    
    uid = c.from_user.id
    bet_data = get_bet(uid)
    if not bet_data or bet_data["game"] != "roulette":
        await c.answer("❌ Сначала введи ставку!", show_alert=True)
        return
    bet = bet_data["bet"]
    if bet > get_balance(uid):
        await c.message.edit_text("❌ Недостаточно средств.", reply_markup=kb_games())
        del_bet(uid)
        await c.answer()
        return
    
    if random.random() < 0.02:
        result = "green"
    else:
        result = random.choice(["red", "black"])
    
    res_emoji = colors[result]
    
    if color == result:
        win = bet * mults[color]
        upd_balance(uid, win)
        add_history(uid, "🎡 Рулетка", win, f"Выигрыш ({res_emoji})")
        await c.message.edit_text(
            f"🎡 *Рулетка*\nВыпало: {res_emoji}\n✅ Ты угадал!\n🎉 +{win} BOLT (x{mults[color]})",
            reply_markup=kb_games(),
            parse_mode="Markdown"
        )
    else:
        upd_balance(uid, -bet)
        add_history(uid, "🎡 Рулетка", -bet, f"Проигрыш ({res_emoji})")
        await c.message.edit_text(
            f"🎡 *Рулетка*\nВыпало: {res_emoji}\n❌ Ты не угадал.\n💸 -{bet} BOLT",
            reply_markup=kb_games(),
            parse_mode="Markdown"
        )
    del_bet(uid)
    await c.answer()

# ====================== БАШНЯ ======================
@dp.callback_query(lambda c: c.data == "tower_start")
async def tower_start(c: CallbackQuery, state: FSMContext):
    uid = c.from_user.id
    bet_data = get_bet(uid)
    if not bet_data or bet_data["game"] != "tower":
        await c.answer("❌ Сначала введи ставку!", show_alert=True)
        return
    bet = bet_data["bet"]
    if bet > get_balance(uid):
        await c.message.edit_text("❌ Недостаточно средств.", reply_markup=kb_games())
        del_bet(uid)
        await c.answer()
        return
    
    max_floors = 8
    current = 0
    multiplier = 1.0
    
    await state.update_data(
        game="tower",
        bet=bet,
        max_floors=max_floors,
        current=current,
        multiplier=multiplier,
        game_over=False
    )
    
    await c.message.edit_text(
        f"🏗️ *Башня*\n\n"
        f"Ставка: *{bet} BOLT*\n"
        f"Максимум: {max_floors} этажей\n"
        f"Множитель: x{multiplier:.1f} (+0.3 за этаж)\n"
        f"Риск падения растёт с каждым этажом\n\n"
        f"Строй или забери:",
        reply_markup=kb_tower_btns(current, max_floors, multiplier),
        parse_mode="Markdown"
    )
    await c.answer()

@dp.callback_query(lambda c: c.data == "t_build")
async def tower_build(c: CallbackQuery, state: FSMContext):
    uid = c.from_user.id
    data = await state.get_data()
    
    if data.get("game_over", False):
        await c.answer("⏳ Игра уже завершена!", show_alert=True)
        return
    
    bet = data.get("bet", 0)
    max_floors = data.get("max_floors", 8)
    current = data.get("current", 0)
    multiplier = data.get("multiplier", 1.0)
    
    if bet == 0:
        await c.answer("❌ Ошибка", show_alert=True)
        return
    
    current += 1
    multiplier = 1.0 + (current * 0.3)
    
    risk = current * 0.05
    
    if random.random() < risk:
        upd_balance(uid, -bet)
        add_history(uid, "🏗️ Башня", -bet, f"Упал на {current} этаже")
        await c.message.edit_text(
            f"🏗️ *Башня*\n💥 Башня рухнула на {current} этаже!\n"
            f"❌ Проигрыш: *-{bet} BOLT*",
            reply_markup=kb_tower_result(),
            parse_mode="Markdown"
        )
        await state.update_data(game_over=True)
        del_bet(uid)
        await c.answer()
        return
    
    if current >= max_floors:
        win = int(bet * multiplier)
        upd_balance(uid, win)
        add_history(uid, "🏗️ Башня", win, f"Построил {current} этажей (x{multiplier:.1f})")
        await c.message.edit_text(
            f"🏗️ *Башня*\n🎉 Ты построил {max_floors} этажей!\n"
            f"Множитель: x{multiplier:.1f}\n"
            f"Выигрыш: *+{win} BOLT*",
            reply_markup=kb_tower_result(),
            parse_mode="Markdown"
        )
        await state.update_data(game_over=True)
        del_bet(uid)
        await c.answer()
        return
    
    await state.update_data(current=current, multiplier=multiplier)
    
    await c.message.edit_text(
        f"🏗️ *Башня*\n\n"
        f"Ставка: *{bet} BOLT*\n"
        f"Этаж: {current}/{max_floors}\n"
        f"Множитель: x{multiplier:.1f} (+0.3 за этаж)\n"
        f"Риск падения: {int(risk * 100)}%\n\n"
        f"Строй или забери:",
        reply_markup=kb_tower_btns(current, max_floors, multiplier),
        parse_mode="Markdown"
    )
    await c.answer()

