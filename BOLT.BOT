# ====================== FSM ======================
class TState(StatesGroup):
    amount = State()
    recipient = State()

class GState(StatesGroup):
    bet = State()

# ====================== КОМАНДЫ ======================
async def set_commands():
    await bot.set_my_commands([])

# ====================== СТАРТ ======================
@dp.message(Command("start"))
