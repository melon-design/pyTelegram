async def cancel(c: CallbackQuery, state: FSMContext):
    del_bet(c.from_user.id)
    await state.clear()
    await c.message.edit_text("❌ Отменено.\n\n🏠 *Главное меню*", reply_markup=kb_main(), parse_mode="Markdown")
    await c.answer()

