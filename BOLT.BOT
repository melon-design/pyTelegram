# ====================== БАЗА ======================
conn = sqlite3.connect('bolt_bot.db', check_same_thread=False)
cursor = conn.cursor()

cursor.execute('''
CREATE TABLE IF NOT EXISTS users (
    user_id INTEGER PRIMARY KEY,
    balance INTEGER DEFAULT 0,
    last_bonus TEXT
)
''')
cursor.execute('''
CREATE TABLE IF NOT EXISTS history (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER,
    type TEXT,
    amount INTEGER,
    detail TEXT,
    date TEXT
)
''')
cursor.execute('''
CREATE TABLE IF NOT EXISTS news (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT,
    content TEXT,
    date TEXT
)
''')
cursor.execute('''
CREATE TABLE IF NOT EXISTS game_bets (
    user_id INTEGER PRIMARY KEY,
    game TEXT,
    bet INTEGER,
    date TEXT
)
''')
conn.commit()

# ====================== ФУНКЦИИ ======================
def get_user(user_id):
    cursor.execute("SELECT balance, last_bonus FROM users WHERE user_id = ?", (user_id,))
    r = cursor.fetchone()
    if not r:
        cursor.execute("INSERT INTO users (user_id, balance, last_bonus) VALUES (?, 0, NULL)", (user_id,))
        conn.commit()
        return 0, None
    return r

def get_balance(user_id):
    cursor.execute("SELECT balance FROM users WHERE user_id = ?", (user_id,))
    r = cursor.fetchone()
    return r[0] if r else 0

def upd_balance(user_id, amount):
    cursor.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (amount, user_id))
    conn.commit()

def set_balance(user_id, amount):
    cursor.execute("UPDATE users SET balance = ? WHERE user_id = ?", (amount, user_id))
    conn.commit()

def set_bonus_date(user_id, date_str):
    cursor.execute("UPDATE users SET last_bonus = ? WHERE user_id = ?", (date_str, user_id))
    conn.commit()

def add_history(user_id, type_, amount, detail):
    d = datetime.now().strftime("%d.%m.%Y %H:%M")
    cursor.execute("INSERT INTO history (user_id, type, amount, detail, date) VALUES (?, ?, ?, ?, ?)",
                   (user_id, type_, amount, detail, d))
    conn.commit()

def get_history(user_id):
    cursor.execute("SELECT type, amount, detail, date FROM history WHERE user_id = ? ORDER BY id DESC LIMIT 20", (user_id,))
    return cursor.fetchall()

def add_news(title, content):
    d = datetime.now().strftime("%d.%m.%Y %H:%M")
    cursor.execute("INSERT INTO news (title, content, date) VALUES (?, ?, ?)", (title, content, d))
    conn.commit()

def get_news():
    cursor.execute("SELECT title, content, date FROM news ORDER BY id DESC")
    return cursor.fetchall()

def add_default_news():
    cursor.execute("SELECT COUNT(*) FROM news")
    if cursor.fetchone()[0] == 0:
        add_news("🚀 Запуск BOLT", "Переводы, бонус 2000 BOLT, комиссия 2% от 5000, Мини-игры: Мины, Рулетка, Башня")

def save_bet(user_id, game, bet):
    d = datetime.now().strftime("%d.%m.%Y %H:%M")
    cursor.execute("INSERT OR REPLACE INTO game_bets (user_id, game, bet, date) VALUES (?, ?, ?, ?)",
                   (user_id, game, bet, d))
    conn.commit()

def get_bet(user_id):
    cursor.execute("SELECT game, bet FROM game_bets WHERE user_id = ?", (user_id,))
    r = cursor.fetchone()
    return {"game": r[0], "bet": r[1]} if r else None

def del_bet(user_id):
    cursor.execute("DELETE FROM game_bets WHERE user_id = ?", (user_id,))
    conn.commit()

def calc_comission(amount):
    if amount >= 5000:
        c = int(amount * 0.02)
        return amount - c, c
    return amount, 0

def get_all_users():
    cursor.execute("SELECT user_id, balance, last_bonus FROM users ORDER BY user_id")
    return cursor.fetchall()

def get_users_count():
    cursor.execute("SELECT COUNT(*) FROM users")
    return cursor.fetchone()[0]

def get_total_balance():
    cursor.execute("SELECT SUM(balance) FROM users")
    r = cursor.fetchone()[0]
    return r if r else 0

