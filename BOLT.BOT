# ---------- ОБЩАЯ СТАВКА ----------
@dp.callback_query(lambda c: c.data.startswith("game_"))
async def game_bet(c: CallbackQuery, state: FSMContext):
    game = c.data.split("_")[1]
    await state.update_data(game=game)
    await state.set_state(GState.bet)
    await c.message.edit_text("💰 Введи сумму ставки в BOLT:", reply_markup=kb_cancel(), parse_mode="Markdown")
    await c.answer()

@dp.message(GState.bet)
async def process_bet(m: types.Message, state: FSMContext):
    if not m.text.isdigit() or int(m.text) <= 0:
        await m.answer("❌ Введи число > 0:")
        return
    bet = int(m.text)
    balance = get_balance(m.from_user.id)
    if bet > balance:
        await m.answer(f"❌ Недостаточно. Баланс: {balance} BOLT")
        return
    data = await state.get_data()
    game = data.get("game")
    save_bet(m.from_user.id, game, bet)
    await state.clear()
    if game == "mines":
        await m.answer("💣 *Мины*\nВыбери сложность:", reply_markup=kb_mines(), parse_mode="Markdown")
    elif game == "roulette":
        await m.answer("🎡 *Рулетка*\nВыбери цвет:", reply_markup=kb_roulette(), parse_mode="Markdown")
    elif game == "tower":
        await m.answer("🏗️ *Башня*\nВыбери этажность:", reply_markup=kb_tower(), parse_mode="Markdown")

# ---------- МИНЫ ----------
@dp.callback_query(lambda c: c.data.startswith("mines_"))
async def mines_start(c: CallbackQuery, state: FSMContext):
    mines = int(c.data.split("_")[1])
    mult = {3: 2, 5: 3, 7: 5}.get(mines, 2)
    uid = c.from_user.id
    bet_data = get_bet(uid)
    if not bet_data or bet_data["game"] != "mines":
        await c.answer("❌ Сначала введи ставку!", show_alert=True)
        return
    bet = bet_data["bet"]
    if bet > get_balance(uid):
        await c.message.edit_text("❌ Недостаточно средств.", reply_markup=kb_games())
        del_bet(uid)
        await c.answer()
        return
    field = [["⬜" for _ in range(5)] for _ in range(5)]
    await state.update_data(mines=mines, mult=mult, bet=bet, field=field)
    await c.message.edit_text(
        f"💣 *Мины ({mines} мин, x{mult})*\nСтавка: *{bet} BOLT*\n\nВыбери клетку:",
        reply_markup=kb_mines_field(field),
        parse_mode="Markdown"
    )
    await c.answer()

@dp.callback_query(lambda c: c.data.startswith("m_"))
async def mines_cell(c: CallbackQuery, state: FSMContext):
    cell = int(c.data.split("_")[1])
    uid = c.from_user.id
    data = await state.get_data()
    mines = data.get("mines", 3)
    mult = data.get("mult", 2)
    bet = data.get("bet", 0)
    field = data.get("field", [["⬜" for _ in range(5)] for _ in range(5)])
    if bet == 0:
        await c.answer("❌ Ошибка", show_alert=True)
        return
    mine_pos = set()
    while len(mine_pos) < mines:
        p = random.randint(0, 24)
        if p != cell:
            mine_pos.add(p)
    row, col = divmod(cell, 5)
    if cell in mine_pos:
        field[row][col] = "💣"
        field_str = "\n".join(["".join(row) for row in field])
        upd_balance(uid, -bet)
        add_history(uid, "💣 Мины", -bet, f"Проигрыш (x{mult})")
        await c.message.edit_text(
            f"💣 *БАХ!* Ты попал на мину!\n\n`{field_str}`\n\n❌ Проигрыш: *-{bet} BOLT*",
            reply_markup=kb_games(),
            parse_mode="Markdown"
        )
        await state.clear()
        del_bet(uid)
    else:
        field[row][col] = "✅"
        win = bet * mult
        upd_balance(uid, win)
        add_history(uid, "💣 Мины", win, f"Выигрыш (x{mult})")
        field_str = "\n".join(["".join(row) for row in field])
        await c.message.edit_text(
            f"✅ *Ты выжил!*\n\n`{field_str}`\n\n🎉 Выигрыш: *+{win} BOLT* (x{mult})",
            reply_markup=kb_games(),
            parse_mode="Markdown"
        )
        await state.clear()
        del_bet(uid)
    await c.answer()

@dp.callback_query(lambda c: c.data == "m_cash")
async def mines_cash(c: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    bet = data.get("bet", 0)
    mult = data.get("mult", 1)
    win = bet * mult
    upd_balance(c.from_user.id, win)
    add_history(c.from_user.id, "💣 Мины", win, f"Забрал (x{mult})")
    await c.message.edit_text(f"💰 *Ты забрал выигрыш!*\n🎉 +{win} BOLT (x{mult})", reply_markup=kb_games(), parse_mode="Markdown")
    await state.clear()
    del_bet(c.from_user.id)
    await c.answer()

# ---------- РУЛЕТКА ----------
@dp.callback_query(lambda c: c.data.startswith("roulette_"))
async def roulette_play(c: CallbackQuery):
    color = c.data.split("_")[1]
    colors = {"red": "🔴", "black": "⚫", "green": "🟢"}
    mults = {"red": 2, "black": 2, "green": 14}
    uid = c.from_user.id
    bet_data = get_bet(uid)
    if not bet_data or bet_data["game"] != "roulette":
        await c.answer("❌ Сначала введи ставку!", show_alert=True)
        return
    bet = bet_data["bet"]
    if bet > get_balance(uid):
        await c.message.edit_text("❌ Недостаточно средств.", reply_markup=kb_games())
        del_bet(uid)
        await c.answer()
        return
    result = random.choice(["red", "black", "green"])
    res_emoji = colors[result]
    if color == result:
        win = bet * mults[color]
        upd_balance(uid, win)
        add_history(uid, "🎡 Рулетка", win, f"Выигрыш ({res_emoji})")
        await c.message.edit_text(
            f"🎡 *Рулетка*\nВыпало: {res_emoji}\n✅ Ты угадал!\n🎉 +{win} BOLT (x{mults[color]})",
            reply_markup=kb_games(),
            parse_mode="Markdown"
        )
    else:
        upd_balance(uid, -bet)
        add_history(uid, "🎡 Рулетка", -bet, f"Проигрыш ({res_emoji})")
        await c.message.edit_text(
            f"🎡 *Рулетка*\nВыпало: {res_emoji}\n❌ Ты не угадал.\n💸 -{bet} BOLT",
            reply_markup=kb_games(),
            parse_mode="Markdown"
        )
    del_bet(uid)
    await c.answer()

# ---------- БАШНЯ ----------
@dp.callback_query(lambda c: c.data.startswith("tower_"))
async def tower_start(c: CallbackQuery, state: FSMContext):
    floors = int(c.data.split("_")[1])
    mults = {3: 2, 5: 4, 7: 8}
    mult = mults.get(floors, 2)
    uid = c.from_user.id
    bet_data = get_bet(uid)
    if not bet_data or bet_data["game"] != "tower":
        await c.answer("❌ Сначала введи ставку!", show_alert=True)
        return
    bet = bet_data["bet"]
    if bet > get_balance(uid):
        await c.message.edit_text("❌ Недостаточно средств.", reply_markup=kb_games())
        del_bet(uid)
        await c.answer()
        return
    await state.update_data(floors=floors, mult=mult, bet=bet, current=0)
    await c.message.edit_text(
        f"🏗️ *Башня ({floors} этажей, x{mult})*\nСтавка: *{bet} BOLT*\nЭтаж: 0/{floors}\nМножитель: x1.0\n\nСтрой или забери:",
        reply_markup=kb_tower_btns(),
        parse_mode="Markdown"
    )
    await c.answer()

@dp.callback_query(lambda c: c.data == "t_build")
async def tower_build(c: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    floors = data.get("floors", 3)
    mult = data.get("mult", 2)
    current = data.get("current", 0)
    bet = data.get("bet", 0)
    uid = c.from_user.id
    if bet == 0:
        await c.answer("❌ Ошибка", show_alert=True)
        return
    current += 1
    risk = 0.1 + (current - 1) * 0.02
    if random.random() < risk:
        upd_balance(uid, -bet)
        add_history(uid, "🏗️ Башня", -bet, f"Упал на {current} этаже")
        await c.message.edit_text(
            f"🏗️ *Башня*\n💥 Рухнула на {current} этаже!\n❌ -{bet} BOLT",
            reply_markup=kb_games(),
            parse_mode="Markdown"
        )
        await state.clear()
        del_bet(uid)
        await c.answer()
        return
    if current >= floors:
        win = bet * mult
        upd_balance(uid, win)
        add_history(uid, "🏗️ Башня", win, f"Построил {floors} этажей")
        await c.message.edit_text(
            f"🏗️ *Башня*\n✅ Построил {floors} этажей!\n🎉 +{win} BOLT (x{mult})",
            reply_markup=kb_games(),
            parse_mode="Markdown"
        )
        await state.clear()
        del_bet(uid)
        await c.answer()
        return
    cur_mult = 1 + (current - 1) * 0.5
    await state.update_data(current=current)
    await c.message.edit_text(
        f"🏗️ *Башня ({floors} этажей, x{mult})*\nСтавка: *{bet} BOLT*\nЭтаж: {current}/{floors}\nМножитель: x{cur_mult:.1f}\n\nСтрой или забери:",
        reply_markup=kb_tower_btns(),
        parse_mode="Markdown"
    )
    await c.answer()

@dp.callback_query(lambda c: c.data == "t_cash")
async def tower_cash(c: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    current = data.get("current", 0)
    bet = data.get("bet", 0)
    uid = c.from_user.id
    if current == 0:
        await c.answer("❌ Не построил ни одного этажа!", show_alert=True)
        return
    win = int(bet * (1 + (current - 1) * 0.5))
    upd_balance(uid, win)
    add_history(uid, "🏗️ Башня", win, f"Забрал на {current} этаже")
    await c.message.edit_text(
        f"🏗️ *Башня*\n✅ Ты забрал выигрыш!\n🎉 +{win} BOLT (x{1 + (current - 1) * 0.5:.1f})",
        reply_markup=kb_games(),
        parse_mode="Markdown"
    )
    await state.clear()
    del_bet(uid)
    await c.answer()

# ====================== ЗАПУСК ======================
async def main():
    await set_commands()
    add_default_news()
    print("🚀 Бот BOLT запущен!")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
