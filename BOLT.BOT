def kb_mines_field(field, opened, multiplier, clicks):
    b = []
    for i in range(5):
        row = []
        for j in range(5):
            cell = i*5 + j
            if opened[cell]:
                emoji = field[i][j]
            else:
                emoji = "⬜"
            row.append(InlineKeyboardButton(text=emoji, callback_data=f"m_{cell}"))
        b.append(row)
    b.append([InlineKeyboardButton(text=f"💰 Забрать (x{multiplier:.1f})", callback_data="m_cash")])
    b.append([InlineKeyboardButton(text="🔙 Назад", callback_data="games")])
    return InlineKeyboardMarkup(inline_keyboard=b)

def kb_mines_result(field):
    b = []
    for i in range(5):
        row = []
        for j in range(5):
            row.append(InlineKeyboardButton(text=field[i][j], callback_data="none"))
        b.append(row)
    b.append([InlineKeyboardButton(text="🔙 Назад", callback_data="games")])
    return InlineKeyboardMarkup(inline_keyboard=b)

