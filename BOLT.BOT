@dp.callback_query(lambda c: c.data == "profile")
async def profile(c: CallbackQuery):
    b = get_balance(c.from_user.id)
    await c.message.edit_text(
        f"👤 *Профиль*\n\n🆔 ID: `{c.from_user.id}`\n💰 Баланс: *{b} BOLT*\n\n🎁 Бонус 2000 BOLT (раз в 24ч)",
        reply_markup=kb_profile(),
        parse_mode="Markdown"
    )
    await c.answer()

@dp.callback_query(lambda c: c.data == "bonus")
async def bonus(c: CallbackQuery):
    uid = c.from_user.id
    _, last = get_user(uid)
    today = datetime.now().date().isoformat()
    if last == today:
        await c.answer("⏳ Бонус уже получен!", show_alert=True)
        return
    upd_balance(uid, 2000)
    set_bonus_date(uid, today)
    add_history(uid, "🎁 Бонус", 2000, "Ежедневный бонус")
    await c.message.edit_text("✅ *Бонус получен!*\n\n🎉 +2000 BOLT", reply_markup=kb_back(), parse_mode="Markdown")
    await c.answer("🎁 +2000 BOLT!", show_alert=True)

# ====================== ПЕРЕВОД ======================
@dp.callback_query(lambda c: c.data == "transfer")
async def transfer(c: CallbackQuery, state: FSMContext):
    await c.message.edit_text("💸 *Перевод*\n\nВведи сумму в BOLT:\n⚠️ От 5000 — комиссия 2%", reply_markup=kb_cancel(), parse_mode="Markdown")
    await state.set_state(TState.amount)
    await c.answer()

@dp.message(TState.amount)
async def process_amount(m: types.Message, state: FSMContext):
    if not m.text.isdigit() or int(m.text) <= 0:
        await m.answer("❌ Введи число > 0:")
        return
    amount = int(m.text)
    balance = get_balance(m.from_user.id)
    if amount > balance:
        await m.answer(f"❌ Недостаточно. Баланс: {balance} BOLT")
        return
    await state.update_data(amount=amount)
    await state.set_state(TState.recipient)
    await m.answer(f"💸 Сумма: *{amount} BOLT*\n\nВведи ID получателя:", reply_markup=kb_cancel(), parse_mode="Markdown")

@dp.message(TState.recipient)
async def process_recipient(m: types.Message, state: FSMContext):
    if not m.text.isdigit():
        await m.answer("❌ ID — только цифры:")
        return
    rid = int(m.text)
    sid = m.from_user.id
    if rid == sid:
        await m.answer("❌ Нельзя перевести себе:")
        return
    if not get_user(rid):
        await m.answer("❌ Пользователь не найден:")
        return
    data = await state.get_data()
    amount = data.get("amount")
    rec_amount, com = calc_comission(amount)
    text = f"📤 *Проверь перевод*\n\n💸 Сумма: *{amount} BOLT*\n👤 Получатель: `{rid}`\n"
    if com > 0:
        text += f"📊 Комиссия 2%: *-{com} BOLT*\n💳 Получит: *{rec_amount} BOLT*"
    await m.answer(text, reply_markup=kb_confirm(rid, amount, com), parse_mode="Markdown")
    await state.clear()

@dp.callback_query(lambda c: c.data.startswith("conf_"))
async def confirm(c: CallbackQuery):
    _, rid, amount = c.data.split("_")
    rid = int(rid)
    amount = int(amount)
    sid = c.from_user.id
    balance = get_balance(sid)
    if amount > balance:
        await c.message.edit_text("❌ Недостаточно средств.", reply_markup=kb_main())
        await c.answer()
        return
    rec_amount, com = calc_comission(amount)
    upd_balance(sid, -amount)
    upd_balance(rid, rec_amount)
    add_history(sid, "💸 Исходящий", -amount, f"Перевод {rid}")
    add_history(rid, "💳 Входящий", rec_amount, f"От {sid}")
    text = f"✅ *Перевод выполнен!*\n\n💸 Отправлено: *{amount} BOLT*\n👤 Получатель: `{rid}`\n"
    if com > 0:
        text += f"📊 Комиссия: *{com} BOLT*\n💳 Получил: *{rec_amount} BOLT*"
    await c.message.edit_text(text, reply_markup=kb_main(), parse_mode="Markdown")
    await c.answer("✅ Перевод успешен!", show_alert=True)

# ====================== ИСТОРИЯ ======================
@dp.callback_query(lambda c: c.data == "history")
async def history(c: CallbackQuery):
    data = get_history(c.from_user.id)
    if not data:
        await c.message.edit_text("📭 *История пуста*", reply_markup=kb_back(), parse_mode="Markdown")
        await c.answer()
        return
    text = "📜 *История (последние 20)*\n\n"
    for t, amount, detail, date in data:
        sign = "+" if amount > 0 else ""
        text += f"{t} {sign}{amount} BOLT | {detail}\n🕐 {date}\n\n"
    if len(text) > 3500:
        text = text[:3500] + "\n...\n📌 Последние операции."
    await c.message.edit_text(text, reply_markup=kb_back(), parse_mode="Markdown")
    await c.answer()

# ====================== НОВОСТИ ======================
@dp.callback_query(lambda c: c.data == "news")
async def news(c: CallbackQuery):
    data = get_news()
    if not data:
        await c.message.edit_text("📰 *Новостей пока нет*", reply_markup=kb_back(), parse_mode="Markdown")
        await c.answer()
        return
    text = "📰 *Новости BOLT*\n\n"
    for title, content, date in data:
        text += f"📌 *{title}*\n🕐 {date}\n{content}\n\n──────────\n\n"
    if len(text) > 4000:
        text = text[:3950] + "\n...\n📌 Показаны последние новости."
    await c.message.edit_text(text, reply_markup=kb_back(), parse_mode="Markdown")
    await c.answer()

