    )
    await state.set_state(AdminState.waiting_user_id)
    await c.answer()

@dp.message(AdminState.waiting_user_id)
async def admin_find_user(m: types.Message, state: FSMContext):
    if not m.text.isdigit():
        await m.answer("❌ Введи корректный ID (только цифры):")
        return
    
    user_id = int(m.text)
    balance = get_balance(user_id)
    
    if balance is None:
        await m.answer("❌ Пользователь с таким ID не найден.\nПопробуй снова:")
        return
    
    await state.update_data(admin_user_id=user_id)
    await state.clear()
    
    await m.answer(
        f"👤 *Информация о пользователе*\n\n"
        f"🆔 ID: `{user_id}`\n"
        f"💰 Баланс: *{balance} BOLT*",
        reply_markup=kb_admin_user_info(user_id, balance),
        parse_mode="Markdown"
    )

@dp.callback_query(lambda c: c.data.startswith("admin_edit_balance_"))
async def admin_edit_balance(c: CallbackQuery, state: FSMContext):
    user_id = int(c.data.split("_")[3])
    await state.update_data(edit_user_id=user_id)
    await state.set_state(AdminState.waiting_new_balance)
    
    await c.message.edit_text(
        f"💰 *Введи новый баланс* для пользователя `{user_id}`:\n\n"
        f"Напиши число (например: 1000 или 0)",
        reply_markup=kb_admin_back(),
        parse_mode="Markdown"
    )
    await c.answer()

@dp.message(AdminState.waiting_new_balance)
async def admin_set_balance(m: types.Message, state: FSMContext):
    if not m.text.isdigit() or int(m.text) < 0:
        await m.answer("❌ Введи корректное число (только цифры, не меньше 0):")
        return
    
    new_balance = int(m.text)
    data = await state.get_data()
    user_id = data.get("edit_user_id")
    
    if user_id is None:
        await m.answer("❌ Ошибка. Попробуй снова /admin_use")
        await state.clear()
        return
    
    # Меняем баланс
    set_balance(user_id, new_balance)
    add_history(user_id, "🛠 Админ", new_balance, f"Админ изменил баланс на {new_balance}")
    
    await state.clear()
    
    await m.answer(
        f"✅ *Баланс изменён!*\n\n"
        f"🆔 ID: `{user_id}`\n"
        f"💰 Новый баланс: *{new_balance} BOLT*",
        reply_markup=kb_admin_back(),
        parse_mode="Markdown"
    )

