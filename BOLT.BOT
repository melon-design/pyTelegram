def kb_mines_field(field):
    b = []
    for i in range(5):
        row = []
        for j in range(5):
            cell = i*5 + j
            row.append(InlineKeyboardButton(text=field[i][j], callback_data=f"m_{cell}"))
        b.append(row)
    b.append([InlineKeyboardButton(text="🏠 Забрать", callback_data="m_cash")])
    return InlineKeyboardMarkup(inline_keyboard=b)

