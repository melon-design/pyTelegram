# ====================== FSM ======================
class TState(StatesGroup):
    amount = State()
    recipient = State()

class GState(StatesGroup):
    bet = State()

class AdminState(StatesGroup):
    waiting_password = State()
    waiting_user_id = State()
    waiting_new_balance = State()

# ====================== КОМАНДЫ ======================
async def set_commands():
    await bot.set_my_commands([
        BotCommand(command="start", description="🏠 Меню"),
        BotCommand(command="admin_use", description="🔐 Админ панель")
    ], scope=BotCommandScopeDefault())

# ====================== СТАРТ ======================
@dp.message(Command("start"))
async def start(m: types.Message):
    get_user(m.from_user.id)
    add_default_news()
    await m.answer("✨ *BOLT* — твоя цифровая валюта.\nВыбери действие:", reply_markup=kb_main(), parse_mode="Markdown")

# ====================== АДМИН ПАНЕЛЬ ======================
@dp.message(Command("admin_use"))
async def admin_use(m: types.Message, state: FSMContext):
    await m.answer("🔐 *Введите пароль для доступа к админ панели:*", parse_mode="Markdown")
    await state.set_state(AdminState.waiting_password)

@dp.message(AdminState.waiting_password)
async def admin_password(m: types.Message, state: FSMContext):
    if m.text == ADMIN_PASSWORD:
        await state.clear()
        await m.answer(
            "🔐 *Админ панель BOLT*\n\n"
            "👥 Все пользователи — список всех пользователей\n"
            "📊 Статистика — общая информация\n\n"
            "Выбери действие:",
            reply_markup=kb_admin_main(),
            parse_mode="Markdown"
        )
    else:
        await m.answer("❌ *Неверный пароль!* Попробуй снова /admin_use", parse_mode="Markdown")
        await state.clear()

@dp.callback_query(lambda c: c.data == "admin_exit")
async def admin_exit(c: CallbackQuery, state: FSMContext):
    await state.clear()
    await c.message.edit_text("🔐 *Выход из админ панели*", reply_markup=kb_main(), parse_mode="Markdown")
    await c.answer()

