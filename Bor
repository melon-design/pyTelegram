import asyncio
import subprocess
import tempfile
import os
import json
from datetime import datetime
from aiogram import Bot, Dispatcher, types
from aiogram.filters import Command
from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton
import logging

logging.basicConfig(level=logging.INFO)

BOT_TOKEN = "8614848012:AAF5b0W4-O8hwLYfOPMqfu4BCosi9wPAio4"
bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()

# Хранилище процессов
processes = {}
# Хранилище ожидающих ввода
waiting_for_input = {}

@dp.message(Command("start"))
async def start_cmd(message: types.Message):
    await message.answer(
        "🤖 **Бот-хостинг для User-ботов**\n\n"
        "Отправь `.py` файл с ботом\n"
        "Я запущу его и покажу консоль\n\n"
        "📌 **Команды:**\n"
        "/console - показать консоль\n"
        "/stop - остановить бота\n"
        "/status - статус\n"
        "/input <текст> - отправить ввод в скрипт",
        parse_mode="Markdown"
    )

@dp.message(lambda message: message.document and message.document.file_name.endswith('.py'))
async def handle_py_file(message: types.Message):
    user_id = message.from_user.id
    
    # Останавливаем старый процесс
    if user_id in processes:
        try:
            processes[user_id].terminate()
            await processes[user_id].wait()
        except:
            pass
        del processes[user_id]
    
    await message.answer("⏳ Загрузка и запуск...")
    
    try:
        # Скачиваем файл
        file = await bot.get_file(message.document.file_id)
        file_content = await bot.download_file(file.file_path)
        code = file_content.read().decode('utf-8')
        
        # Сохраняем
        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False, encoding='utf-8') as f:
            f.write(code)
            temp_file = f.name
        
        # Добавляем обертку для перехвата input()
        wrapped_code = f'''
import sys
import json
import os
from datetime import datetime

# Файл для обмена данными с ботом
INPUT_FILE = "/tmp/bot_input_{user_id}.json"

def custom_input(prompt=""):
    """Перехват input() для отправки через бота"""
    print(prompt, end="", flush=True)
    
    # Сохраняем запрос
    with open(INPUT_FILE, 'w') as f:
        json.dump({{
            'waiting': True,
            'prompt': prompt,
            'timestamp': datetime.now().isoformat()
        }}, f)
    
    # Ждем ответ
    while True:
        try:
            with open(INPUT_FILE, 'r') as f:
                data = json.load(f)
                if 'response' in data and data['response']:
                    response = data['response']
                    # Очищаем ответ
                    data['response'] = None
                    data['waiting'] = False
                    with open(INPUT_FILE, 'w') as f2:
                        json.dump(data, f2)
                    return response
        except:
            pass
        import time
        time.sleep(0.5)

# Заменяем input на наш
import builtins
builtins.input = custom_input

# Запускаем пользовательский код
exec(open(r'{temp_file}').read())
'''
        
        # Сохраняем обернутый код
        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False, encoding='utf-8') as f:
            f.write(wrapped_code)
            runner_file = f.name
        
        # Запускаем
        proc = await asyncio.create_subprocess_exec(
            'python', '-u', runner_file,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL
        )
        
        processes[user_id] = proc
        proc.temp_file = temp_file
        proc.runner_file = runner_file
        proc.output_lines = []
        proc.user_id = user_id
        
        # Запускаем мониторинг
        asyncio.create_task(monitor_output(proc))
        
        await message.answer(
            f"✅ **Бот запущен!**\n\n"
            f"📁 {message.document.file_name}\n"
            f"🆔 PID: {proc.pid}\n\n"
            f"📟 Смотри вывод: /console\n"
            f"🛑 Остановить: /stop",
            parse_mode="Markdown"
        )
        
    except Exception as e:
        await message.answer(f"❌ Ошибка: {str(e)}")

async def monitor_output(proc):
    """Мониторинг вывода"""
    user_id = proc.user_id
    input_file = f"/tmp/bot_input_{user_id}.json"
    
    while True:
        try:
            line = await asyncio.wait_for(proc.stdout.readline(), timeout=1.0)
            if not line:
                if proc.poll() is not None:
                    break
                continue
            
            text = line.decode('utf-8', errors='ignore').strip()
            if text:
                proc.output_lines.append(text)
                if len(proc.output_lines) > 1000:
                    proc.output_lines = proc.output_lines[-1000:]
                
                logging.info(f"[{user_id}] {text}")
                
                # Проверяем, запрашивает ли скрипт ввод
                if any(word in text.lower() for word in ['введите', 'enter', 'code', 'код', 'password', 'пароль']):
                    # Отправляем уведомление пользователю
                    keyboard = InlineKeyboardMarkup(inline_keyboard=[
                        [InlineKeyboardButton(text="✏️ Ввести код", callback_data=f"input_{user_id}")]
                    ])
                    
                    await bot.send_message(
                        user_id,
                        f"⌨️ **Скрипт запрашивает ввод:**\n\n"
                        f"```\n{text[:300]}\n```\n\n"
                        f"Отправь ответ командой:\n"
                        f"`.input <ответ>`\n\n"
                        f"Например: `.input 12345`",
                        parse_mode="Markdown",
                        reply_markup=keyboard
                    )
                    
                    # Сохраняем состояние
                    waiting_for_input[user_id] = True
                    
        except asyncio.TimeoutError:
            continue
        except Exception as e:
            logging.error(f"Ошибка: {e}")
            break
    
    # Очистка
    try:
        os.unlink(proc.temp_file)
        os.unlink(proc.runner_file)
        if os.path.exists(input_file):
            os.unlink(input_file)
    except:
        pass
    
    if user_id in processes:
        del processes[user_id]
    if user_id in waiting_for_input:
        del waiting_for_input[user_id]

@dp.message(Command("input"))
async def input_cmd(message: types.Message):
    """Показать статус ввода"""
    user_id = message.from_user.id
    if user_id in waiting_for_input:
        await message.answer(
            "⌨️ **Скрипт ожидает ввод**\n\n"
            "Отправь ответ:\n"
            "`.input <текст>`\n\n"
            "Пример: `.input 12345`",
            parse_mode="Markdown"
        )
    else:
        await message.answer("❌ Скрипт не ожидает ввод")

@dp.message(lambda message: message.text and message.text.startswith('.input '))
async def handle_input(message: types.Message):
    """Обработка ввода"""
    user_id = message.from_user.id
    response = message.text[7:]  # Убираем ".input "
    
    if not response:
        await message.answer("❌ Введи текст: `.input 12345`")
        return
    
    # Проверяем, ожидает ли скрипт ввод
    if user_id not in waiting_for_input:
        await message.answer("❌ Скрипт не ожидает ввод")
        return
    
    # Отправляем ввод через файл
    input_file = f"/tmp/bot_input_{user_id}.json"
    try:
        with open(input_file, 'r') as f:
            data = json.load(f)
        data['response'] = response
        with open(input_file, 'w') as f:
            json.dump(data, f)
        
        waiting_for_input[user_id] = False
        await message.answer(f"✅ Ввод отправлен:\n```\n{response[:100]}\n```", parse_mode="Markdown")
        
    except Exception as e:
        await message.answer(f"❌ Ошибка: {e}")

@dp.callback_query(lambda c: c.data and c.data.startswith('input_'))
async def input_callback(callback: types.CallbackQuery):
    """Обработка кнопки ввода"""
    user_id = int(callback.data.split('_')[1])
    if callback.from_user.id != user_id:
        await callback.answer("❌ Это не твой запрос", show_alert=True)
        return
    
    await callback.message.answer(
        "⌨️ **Введи ответ командой:**\n"
        "`.input <текст>`\n\n"
        "Пример: `.input 12345`",
        parse_mode="Markdown"
    )
    await callback.answer()

@dp.message(Command("console"))
async def console_cmd(message: types.Message):
    """Показать консоль"""
    user_id = message.from_user.id
    if user_id in processes:
        proc = processes[user_id]
        lines = proc.output_lines[-30:] if proc.output_lines else ["📟 Нет вывода"]
        text = "\n".join(lines)
        
        if len(text) > 4000:
            with tempfile.NamedTemporaryFile(mode='w', suffix='.txt', delete=False) as f:
                f.write(text)
                await message.answer_document(
                    types.FSInputFile(f.name),
                    caption=f"📟 Консоль ({len(proc.output_lines)} строк)"
                )
                os.unlink(f.name)
        else:
            await message.answer(
                f"📟 **Консоль:**\n```\n{text}\n```",
                parse_mode="Markdown"
            )
    else:
        await message.answer("❌ Нет активных скриптов")

@dp.message(Command("stop"))
async def stop_cmd(message: types.Message):
    """Остановка"""
    user_id = message.from_user.id
    if user_id in processes:
        try:
            processes[user_id].terminate()
            await processes[user_id].wait()
        except:
            processes[user_id].kill()
        del processes[user_id]
        await message.answer("✅ Скрипт остановлен")
    else:
        await message.answer("❌ Нет активных скриптов")

@dp.message(Command("status"))
async def status_cmd(message: types.Message):
    """Статус"""
    user_id = message.from_user.id
    if user_id in processes:
        proc = processes[user_id]
        status = "🟢 Работает" if proc.poll() is None else "🔴 Остановлен"
        await message.answer(
            f"**Статус:** {status}\n"
            f"**PID:** {proc.pid}\n"
            f"**Строк:** {len(proc.output_lines)}\n"
            f"**Ожидает ввод:** {'Да' if user_id in waiting_for_input else 'Нет'}",
            parse_mode="Markdown"
        )
    else:
        await message.answer("❌ Нет активных скриптов")

async def main():
    print("🚀 Бот-хостинг запущен!")
    await dp.start_polling(bot)

if __name__ == '__main__':
    asyncio.run(main())
