import telebot
from telebot import types
import os
import subprocess
import sys

TOKEN = '8001099846:AAEpC_DtgBiXC42tcu9XUQZUuBOgiRk2DfE'
ADMIN_ID = 8893906363  # Твой Telegram ID (узнай в @userinfobot)

bot = telebot.TeleBot(TOKEN)

# Папка для сохранения скрипта и имя файла
HOSTING_DIR = "hosted_scripts"
SCRIPT_NAME = "user_script.py"
SCRIPT_PATH = os.path.join(HOSTING_DIR, SCRIPT_NAME)

# Глобальные переменные для управления процессом
current_process = None
is_waiting_for_file = False

if not os.path.exists(HOSTING_DIR):
    os.makedirs(HOSTING_DIR)

def is_admin(chat_id):
    return chat_id == ADMIN_ID

# Функция для создания меню управления
def get_management_keyboard():
    global current_process
    keyboard = types.InlineKeyboardMarkup(row_width=1)
    
    # Проверяем, запущен ли процесс на самом деле
    is_running = current_process is not None and current_process.poll() is None
    
    status_btn = types.InlineKeyboardButton(
        text=f"📊 Статус: {'🟢 Запущен' if is_running else '🔴 Остановлен'}", 
        callback_data="status"
    )
    upload_btn = types.InlineKeyboardButton(text="📥 Загрузить/Обновить файл", callback_data="upload")
    start_btn = types.InlineKeyboardButton(text="▶️ Старт скрипта", callback_data="start_script")
    stop_btn = types.InlineKeyboardButton(text="⏹️ Стоп скрипта", callback_data="stop_script")
    
    keyboard.add(status_btn, upload_btn, start_btn, stop_btn)
    return keyboard

@bot.message_handler(commands=['start'])
def send_welcome(message):
    if not is_admin(message.chat.id):
        bot.reply_to(message, "⛔ Доступ запрещен.")
        return
    
    bot.send_message(
        message.chat.id, 
        "🤖 Добро пожаловать в панель управления хостингом!\n\nИспользуй кнопки ниже для управления твоим скриптом.", 
        reply_markup=get_management_keyboard()
    )

@bot.callback_query_handler(func=lambda call: True)
def handle_query(call):
    global current_process, is_waiting_for_file
    chat_id = call.message.chat.id

    if not is_admin(chat_id):
        bot.answer_callback_query(call.id, "⛔ Нет прав.")
        return

    # Проверяем реальное состояние процесса перед действиями
    is_running = current_process is not None and current_process.poll() is None

    if call.data == "status":
        bot.answer_callback_query(call.id, f"Скрипт {'работает' if is_running else 'выключен'}")
        
    elif call.data == "upload":
        if is_running:
            bot.send_message(chat_id, "⚠️ Сначала остановите текущий скрипт кнопкой 'Стоп скрипта'.")
            bot.answer_callback_query(call.id)
            return
        is_waiting_for_file = True
        bot.send_message(chat_id, "📂 Отправь мне `.py` файл с кодом. Я сохраню его для запуска.")
        bot.answer_callback_query(call.id)

    elif call.data == "start_script":
        if is_running:
            bot.send_message(chat_id, "ℹ️ Скрипт уже запущен и работает 24/7.")
        elif not os.path.exists(SCRIPT_PATH):
            bot.send_message(chat_id, "❌ Файл скрипта не найден. Сначала загрузи его.")
        else:
            try:
                # Запуск процесса
                current_process = subprocess.Popen([sys.executable, SCRIPT_PATH])
                bot.send_message(chat_id, "🚀 Скрипт успешно запущен в фоне!")
                # Обновляем меню в исходном сообщении
                bot.edit_message_reply_markup(chat_id, call.message.message_id, reply_markup=get_management_keyboard())
            except Exception as e:
                bot.send_message(chat_id, f"❌ Ошибка при старте: {e}")
        bot.answer_callback_query(call.id)

    elif call.data == "stop_script":
        if is_running:
            current_process.terminate()
            current_process.wait()  # Ждем корректного закрытия
            current_process = None
            bot.send_message(chat_id, "🛑 Скрипт остановлен.")
            bot.edit_message_reply_markup(chat_id, call.message.message_id, reply_markup=get_management_keyboard())
        else:
            bot.send_message(chat_id, "ℹ️ Скрипт и так остановлен.")
        bot.answer_callback_query(call.id)

@bot.message_handler(content_types=['document'])
def handle_docs(message):
    global is_waiting_for_file
    chat_id = message.chat.id

    if not is_admin(chat_id):
        return

    if not is_waiting_for_file:
        bot.reply_to(message, "⚠️ Чтобы загрузить файл, сначала нажмите кнопку на панели.")
        return

    file_name = message.document.file_name
    if not file_name.endswith('.py'):
        bot.reply_to(message, "⚠️ Принимаются только файлы с расширением `.py`")
        return

    try:
        file_info = bot.get_file(message.document.file_id)
        downloaded_file = bot.download_file(file_info.file_path)

        # Всегда сохраняем под одним фиксированным именем для простоты управления
        with open(SCRIPT_PATH, 'wb') as new_file:
            new_file.write(downloaded_file)

        is_waiting_for_file = False
        bot.reply_to(
            message, 
            f"✅ Файл `{file_name}` успешно загружен.\nТеперь вы можете запустить его кнопкой 'Старт скрипта'.", 
            parse_mode="Markdown",
            reply_markup=get_management_keyboard()
        )

    except Exception as e:
        bot.reply_to(message, f"❌ Произошла ошибка при сохранении: {e}")

if __name__ == '__main__':
    print("Бот-панель хостинга запущена...")
    bot.infinity_polling()
