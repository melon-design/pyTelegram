import telebot
from telebot import types
import os
import subprocess
import sys

# ================= НАСТРОЙКИ =================
TOKEN = '8001099846:AAEpC_DtgBiXC42tcu9XUQZUuBOgiRk2DfE'
ADMIN_ID = 8893906363  # Твой Telegram ID

bot = telebot.TeleBot(TOKEN)

# Папка и имя файла для хостинга
HOSTING_DIR = "hosted_scripts"
SCRIPT_NAME = "user_script.py"
SCRIPT_PATH = os.path.join(HOSTING_DIR, SCRIPT_NAME)

# Глобальные переменные для состояний
current_process = None
is_waiting_for_file = False

# Создаем папку, если ее нет
if not os.path.exists(HOSTING_DIR):
    os.makedirs(HOSTING_DIR)

# ================= ФУНКЦИИ =================
def is_admin(chat_id):
    return chat_id == ADMIN_ID

def get_management_keyboard():
    """Создает и возвращает меню с кнопками"""
    global current_process
    keyboard = types.InlineKeyboardMarkup(row_width=1)
    
    is_running = current_process is not None and current_process.poll() is None
    status_text = "🟢 Запущен" if is_running else "🔴 Остановлен"
    
    status_btn = types.InlineKeyboardButton(text=f"📊 Статус: {status_text}", callback_data="status")
    upload_btn = types.InlineKeyboardButton(text="📥 Загрузить/Обновить файл", callback_data="upload")
    start_btn = types.InlineKeyboardButton(text="▶️ Старт скрипта", callback_data="start_script")
    stop_btn = types.InlineKeyboardButton(text="⏹️ Стоп скрипта", callback_data="stop_script")
    
    keyboard.add(status_btn, upload_btn, start_btn, stop_btn)
    return keyboard

def update_keyboard_safe(chat_id, message_id):
    """Безопасно обновляет клавиатуру, игнорируя ошибку 'message is not modified'"""
    try:
        bot.edit_message_reply_markup(chat_id, message_id, reply_markup=get_management_keyboard())
    except telebot.apihelper.ApiTelegramException as e:
        if "message is not modified" not in e.description:
            raise e  # Прокидываем ошибку дальше, если это что-то другое

# ================= ОБРАБОТЧИКИ =================
@bot.message_handler(commands=['start'])
def send_welcome(message):
    if not is_admin(message.chat.id):
        bot.reply_to(message, "⛔ Доступ запрещен.")
        return
    
    bot.send_message(
        message.chat.id, 
        "🤖 **Панель управления хостингом**\n\nИспользуй кнопки ниже для управления твоим кодом.", 
        parse_mode="Markdown",
        reply_markup=get_management_keyboard()
    )

@bot.callback_query_handler(func=lambda call: True)
def handle_query(call):
    global current_process, is_waiting_for_file
    chat_id = call.message.chat.id

    if not is_admin(chat_id):
        bot.answer_callback_query(call.id, "⛔ Нет прав.")
        return

    is_running = current_process is not None and current_process.poll() is None

    if call.data == "status":
        bot.answer_callback_query(call.id, f"Скрипт {'сейчас работает' if is_running else 'выключен'}")
        update_keyboard_safe(chat_id, call.message.message_id)

    elif call.data == "upload":
        if is_running:
            # Показываем всплывающее окно (alert), чтобы не мусорить в чате
            bot.answer_callback_query(call.id, "⚠️ Сначала останови текущий скрипт!", show_alert=True)
            return
        
        is_waiting_for_file = True
        bot.send_message(chat_id, "📂 Отправь мне `.py` файл с кодом.")
        bot.answer_callback_query(call.id)

    elif call.data == "start_script":
        if is_running:
            bot.answer_callback_query(call.id, "ℹ️ Скрипт уже запущен и работает.", show_alert=True)
        elif not os.path.exists(SCRIPT_PATH):
            bot.answer_callback_query(call.id, "❌ Файл не найден. Сначала загрузи его.", show_alert=True)
        else:
            try:
                current_process = subprocess.Popen([sys.executable, SCRIPT_PATH])
                bot.answer_callback_query(call.id, "🚀 Скрипт успешно запущен!")
                update_keyboard_safe(chat_id, call.message.message_id)
            except Exception as e:
                bot.send_message(chat_id, f"❌ Ошибка при старте: {e}")
                bot.answer_callback_query(call.id)

    elif call.data == "stop_script":
        if is_running:
            current_process.terminate()
            current_process.wait()
            current_process = None
            bot.answer_callback_query(call.id, "🛑 Скрипт остановлен.")
            update_keyboard_safe(chat_id, call.message.message_id)
        else:
            bot.answer_callback_query(call.id, "ℹ️ Скрипт и так остановлен.", show_alert=True)

@bot.message_handler(content_types=['document'])
def handle_docs(message):
    global is_waiting_for_file
    chat_id = message.chat.id

    if not is_admin(chat_id):
        return

    if not is_waiting_for_file:
        bot.reply_to(message, "⚠️ Нажми кнопку '📥 Загрузить/Обновить файл' перед отправкой.")
        return

    file_name = message.document.file_name
    if not file_name.endswith('.py'):
        bot.reply_to(message, "⚠️ Принимаются только файлы `.py`")
        return

    try:
        bot.send_chat_action(chat_id, 'upload_document')
        file_info = bot.get_file(message.document.file_id)
        downloaded_file = bot.download_file(file_info.file_path)

        with open(SCRIPT_PATH, 'wb') as new_file:
            new_file.write(downloaded_file)

        is_waiting_for_file = False
        
        # Отправляем новую панель с кнопками
        bot.reply_to(
            message, 
            "✅ Файл успешно загружен!\nТеперь ты можешь запустить его.", 
            reply_markup=get_management_keyboard()
        )

    except Exception as e:
        bot.reply_to(message, f"❌ Ошибка при сохранении файла: {e}")

if __name__ == '__main__':
    print("Бот-панель хостинга запущена и готова к работе...")
    bot.infinity_polling(timeout=10, long_polling_timeout=5)
