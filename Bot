@dp.message(Command("install"))
async def install_cmd(message: types.Message):
    """Установка библиотеки"""
    args = message.text.split()
    if len(args) < 2:
        await message.answer("❌ Укажи библиотеку: /install telethon")
        return
    
    lib = args[1]
    await message.answer(f"📦 Устанавливаю {lib}...")
    
    try:
        proc = await asyncio.create_subprocess_exec(
            'pip', 'install', lib,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        
        if proc.returncode == 0:
            await message.answer(f"✅ {lib} успешно установлен!")
        else:
            await message.answer(f"❌ Ошибка установки:\n{stderr.decode()[:200]}")
    except Exception as e:
        await message.answer(f"❌ Ошибка: {e}")

@dp.message(lambda message: message.document and message.document.file_name.endswith('.py'))
async def handle_py_file(message: types.Message):
    """Обработка загруженного .py файла"""
    user_id = message.from_user.id
    
    # Останавливаем старый скрипт
    if user_id in processes:
        proc = processes[user_id]
        proc.terminate()
        await proc.wait()
        del processes[user_id]
    
    await message.answer("⏳ Загрузка и подготовка...")
    
    try:
        # Скачиваем файл
        file = await bot.get_file(message.document.file_id)
        file_content = await bot.download_file(file.file_path)
        code = file_content.read().decode('utf-8')
        
        # Сохраняем во временный файл
        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False, encoding='utf-8') as f:
            f.write(code)
            temp_file = f.name
        
        # Проверяем наличие requirements.txt в той же папке
        req_file = os.path.join(os.path.dirname(temp_file), 'requirements.txt')
        
        # Создаем улучшенный запускающий скрипт
        runner_code = f'''
