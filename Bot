import sys
import os

# Устанавливаем зависимости
try:
    import telethon
except ImportError:
    print("📦 Устанавливаю telethon...")
    subprocess.check_call([sys.executable, "-m", "pip", "install", "telethon"])

try:
    import psutil
except ImportError:
    print("📦 Устанавливаю psutil...")
    subprocess.check_call([sys.executable, "-m", "pip", "install", "psutil"])

# Запускаем основной скрипт
print("🚀 Запуск основного скрипта...")
exec(open(r'{temp_file}').read())
'''
        
        # Сохраняем раннер
        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False, encoding='utf-8') as f:
            f.write(runner_code)
            runner_file = f.name
        
        # Запускаем скрипт через раннер
        proc = await asyncio.create_subprocess_exec(
            'python', '-u', runner_file,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            stdin=subprocess.PIPE,
            cwd=os.path.dirname(temp_file)
        )
        
        processes[user_id] = proc
        proc.temp_file = temp_file
        proc.runner_file = runner_file
        proc.output_lines = []
        
        # Запускаем мониторинг
        asyncio.create_task(monitor_output(proc, user_id))
        
        await message.answer(
            f"✅ **Скрипт запущен!**\n\n"
            f"📁 Файл: {message.document.file_name}\n"
            f"🆔 PID: {proc.pid}\n"
            f"📦 Зависимости установлены\n\n"
            f"📟 Консоль: /console\n"
            f"🛑 Остановить: /stop",
            parse_mode="Markdown"
        )
        
    except Exception as e:
        await message.answer(f"❌ Ошибка: {str(e)}")

async def monitor_output(proc, user_id):
    """Мониторинг вывода"""
    while True:
        try:
            line = await asyncio.wait_for(proc.stdout.readline(), timeout=1.0)
            if not line:
                if proc.poll() is not None:
                    break
                continue
            
            decoded = line.decode('utf-8', errors='ignore').strip()
            if decoded:
                proc.output_lines.append(decoded)
                if len(proc.output_lines) > 1000:
                    proc.output_lines = proc.output_lines[-1000:]
                
                # Если скрипт запрашивает ввод
                if any(word in decoded.lower() for word in ['введите', 'enter', 'code', 'код']):
                    await bot.send_message(
                        user_id,
                        f"⌨️ **Запрос ввода:**\n```\n{decoded[:200]}\n```\nОтправь ответ в этот чат",
                        parse_mode="Markdown"
                    )
                    proc.waiting_for_input = True
                
                logging.info(f"[{user_id}] {decoded}")
                
        except asyncio.TimeoutError:
            continue
        except Exception as e:
            logging.error(f"Ошибка: {e}")
            break
    
    # Очистка
    try:
        os.unlink(proc.temp_file)
        os.unlink(proc.runner_file)
    except:
        pass
    
    if user_id in processes:
        del processes[user_id]

@dp.message()
async def handle_input(message: types.Message):
    """Обработка ввода для скрипта"""
    user_id = message.from_user.id
    if user_id in processes:
        proc = processes[user_id]
        if hasattr(proc, 'waiting_for_input') and proc.waiting_for_input:
            try:
                proc.stdin.write((message.text + '\n').encode())
                await proc.stdin.drain()
                proc.waiting_for_input = False
                await message.answer("✅ Ввод отправлен")
            except Exception as e:
                await message.answer(f"❌ Ошибка: {e}")

@dp.message(Command("console"))
async def console_cmd(message: types.Message):
    """Показать консоль"""
    user_id = message.from_user.id
    if user_id in processes:
        proc = processes[user_id]
        lines = proc.output_lines[-30:] if proc.output_lines else ["Нет вывода"]
        text = "\n".join(lines)
        
        if len(text) > 4000:
            with tempfile.NamedTemporaryFile(mode='w', suffix='.txt', delete=False) as f:
                f.write(text)
                await message.answer_document(
                    types.FSInputFile(f.name),
                    caption=f"📟 Консоль ({len(proc.output_lines)} строк)"
                )
                os.unlink(f.name)
        else:
            await message.answer(
                f"📟 **Консоль:**\n```\n{text}\n```",
                parse_mode="Markdown"
            )
    else:
        await message.answer("❌ Нет активных скриптов")

