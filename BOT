def get_user(user_id):
    if user_id not in users_db:
        users_db[user_id] = {
            'balance': 100,  # Стартовый баланс для теста
            'game_history': [],
            'created_at': datetime.now().isoformat()
        }
    return jsonify(users_db[user_id])

@app.route('/api/user/<int:user_id>/balance', methods=['POST'])
def update_balance(user_id):
    data = request.json
    if user_id in users_db:
        users_db[user_id]['balance'] = data.get('balance', 0)
        return jsonify({'success': True})
    return jsonify({'error': 'User not found'}), 404

@app.route('/api/user/<int:user_id>/history', methods=['POST'])
def add_game_history(user_id):
    data = request.json
    if user_id in users_db:
        game_record = {
            'game': data.get('game', 'mines'),
            'bet': data.get('bet', 0),
            'mines': data.get('mines', 0),
            'result': data.get('result', 'loss'),
            'profit': data.get('profit', 0),
            'timestamp': datetime.now().isoformat()
        }
        users_db[user_id]['game_history'].append(game_record)
        return jsonify({'success': True})
    return jsonify({'error': 'User not found'}), 404

# Telegram Bot
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработчик команды /start"""
    user_id = update.effective_user.id
    user_name = update.effective_user.first_name
    
    # Создаем пользователя если не существует
    if user_id not in users_db:
        users_db[user_id] = {
            'balance': 100,  # Стартовый баланс для теста
            'game_history': [],
            'created_at': datetime.now().isoformat()
        }
    
    # Создаем клавиатуру с кнопкой Mini App
    keyboard = [
        [InlineKeyboardButton(
            "🎮 Играть в Force Games", 
            web_app=WebAppInfo(url=f"{WEBAPP_URL}/mini-app")
        )]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    welcome_text = f"""
⚡ *Добро пожаловать в Force Games, {user_name}!*

🎮 Нажмите на кнопку ниже, чтобы начать играть:

• *Мины* - открывайте ячейки и собирайте выигрыш!
• Минимальная ставка: 10 ⭐
• Выбор количества мин: 1, 3, 5, 10
• Система множителей для больших выигрышей

💰 Для пополнения баланса обратитесь к @ForceGames_Moders
💸 Вывод средств от 100 ⭐

_Удачи в игре!_
    """
    
    await update.message.reply_text(
        welcome_text,
        reply_markup=reply_markup,
        parse_mode='Markdown'
    )

def run_flask():
    """Запуск Flask сервера"""
    app.run(host='0.0.0.0', port=5000, debug=False)

def main():
    """Основная функция запуска бота"""
    # Запускаем Flask в отдельном потоке
    flask_thread = threading.Thread(target=run_flask)
    flask_thread.daemon = True
    flask_thread.start()
    
    # Создаем и запускаем бота
    application = Application.builder().token(BOT_TOKEN).build()
    
    # Добавляем обработчики
    application.add_handler(CommandHandler("start", start))
    
    # Запускаем бота
    logger.info("Бот запущен...")
    application.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == '__main__':
    main()
