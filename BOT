@dp.message(ZipUpload.waiting_for_zip, F.document)
async def process_zip(message: Message, state: FSMContext):
    doc = message.document
    
    if not doc.file_name.endswith('.zip'):
        await message.answer("❌ Только ZIP архивы!")
        return
    
    status = await message.answer("📥 Скачиваю...")
    
    try:
        file = await bot.get_file(doc.file_id)
        file_bytes = await bot.download_file(file.file_path)
        
        with zipfile.ZipFile(io.BytesIO(file_bytes.read())) as zf:
            if 'index.html' not in zf.namelist():
                await status.edit_text("❌ Нет index.html!")
                await state.clear()
                return
            
            temp_dir = APPS_DIR / "temp" / str(message.from_user.id) / str(uuid.uuid4())[:8]
            temp_dir.mkdir(parents=True, exist_ok=True)
            zf.extractall(temp_dir)
        
        await state.update_data(temp_dir=str(temp_dir))
        await status.edit_text("✅ Архив получен!\nВведите название:")
        await state.set_state(ZipUpload.waiting_for_name)
        
    except Exception as e:
        await status.edit_text(f"❌ Ошибка: {e}")
        await state.clear()

