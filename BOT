# ===================== УПРАВЛЕНИЕ ПРОЦЕССАМИ (УПРОЩЕННОЕ) =====================
class ProcessManager:
    def __init__(self):
        self.processes: Dict[str, Any] = {}
        self.next_port = 9000
    
    def start_app(self, app_id: str) -> int:
        app = db.get_app(app_id)
        if not app:
            raise ValueError("App not found")
        
        app_dir = APPS_DIR / app_id
        app_file = app_dir / app["filename"]
        
        if not app_file.exists():
            raise FileNotFoundError(f"File not found: {app_file}")
        
        port = self.next_port
        self.next_port += 1
        
        try:
            if app["type"] == "html":
                # Для HTML - встроенный сервер
                process = subprocess.Popen(
                    [sys.executable, "-m", "http.server", str(port)],
                    cwd=str(app_dir),
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
            else:
                # Для Python
                env = os.environ.copy()
                env["PORT"] = str(port)
                process = subprocess.Popen(
                    [sys.executable, str(app_file)],
                    cwd=str(app_dir),
                    env=env,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
            
            time.sleep(1)
            
            if process.poll() is not None:
                raise RuntimeError("Process failed to start")
            
            self.processes[app_id] = {"process": process, "port": port}
            db.update_app(app_id, {"local_port": port, "status": "running"})
            logger.info(f"App {app_id} started on port {port}")
            return port
            
        except Exception as e:
            logger.error(f"Failed to start app {app_id}: {e}")
            raise
    
    def stop_app(self, app_id: str):
        if app_id in self.processes:
            try:
                self.processes[app_id]["process"].terminate()
                self.processes[app_id]["process"].wait(timeout=3)
            except:
                self.processes[app_id]["process"].kill()
            del self.processes[app_id]
            db.update_app(app_id, {"status": "stopped"})
    
    def is_running(self, app_id: str) -> bool:
        return app_id in self.processes and self.processes[app_id]["process"].poll() is None
    
    def cleanup(self):
        for app_id in list(self.processes.keys()):
            self.stop_app(app_id)

process_manager = ProcessManager()

# ===================== УПРАВЛЕНИЕ ТУННЕЛЯМИ (УПРОЩЕННОЕ) =====================
class TunnelManager:
    def __init__(self):
        self.tunnels: Dict[str, Any] = {}
    
    def create_tunnel(self, app_id: str, port: int) -> str:
        # Используем localhost.run (бесплатно, без регистрации)
        try:
            cmd = [
                "ssh", "-o", "StrictHostKeyChecking=no",
                "-o", "ServerAliveInterval=60",
                "-R", f"80:localhost:{port}",
                "nokey@localhost.run"
            ]
            
            process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            # Ждем URL
            time.sleep(3)
            output = ""
            for _ in range(20):
                line = process.stdout.readline()
                if line:
                    output += line
                    # Ищем URL вида https://XXXX.lhr.life
                    match = re.search(r'https://[a-zA-Z0-9\-]+\.lhr\.life', output)
                    if match:
                        url = match.group(0)
                        self.tunnels[app_id] = {"process": process, "url": url}
                        db.update_app(app_id, {"url": url})
                        logger.info(f"Tunnel created: {url}")
                        return url
                time.sleep(1)
            
            process.kill()
            raise Exception("URL not found in output")
            
        except FileNotFoundError:
            logger.error("SSH not found! Using local URL instead")
            # Если SSH недоступен, используем локальный URL
            url = f"http://localhost:{port}"
            db.update_app(app_id, {"url": url})
            return url
        except Exception as e:
            logger.error(f"Tunnel error: {e}")
            # Fallback: локальный URL
            url = f"http://localhost:{port}"
            db.update_app(app_id, {"url": url})
            return url
    
    def stop_tunnel(self, app_id: str):
        if app_id in self.tunnels:
            try:
                self.tunnels[app_id]["process"].terminate()
                self.tunnels[app_id]["process"].wait(timeout=3)
            except:
                self.tunnels[app_id]["process"].kill()
            del self.tunnels[app_id]
    
    def cleanup(self):
        for app_id in list(self.tunnels.keys()):
            self.stop_tunnel(app_id)

