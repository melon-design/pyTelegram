# ===================== БАЗА ДАННЫХ =====================
class AppsDatabase:
    def __init__(self):
        self.db_file = Path(DB_FILE)
        self.apps: Dict[str, Dict[str, Any]] = {}
        self.load()
    
    def load(self):
        if self.db_file.exists():
            try:
                with open(self.db_file, 'r', encoding='utf-8') as f:
                    self.apps = json.load(f)
                logger.info(f"Loaded {len(self.apps)} apps from database")
            except Exception as e:
                logger.error(f"Error loading database: {e}")
                self.apps = {}
    
    def save(self):
        try:
            with open(self.db_file, 'w', encoding='utf-8') as f:
                json.dump(self.apps, f, ensure_ascii=False, indent=2)
        except Exception as e:
            logger.error(f"Error saving database: {e}")
    
    def add_app(self, user_id: int, app_data: Dict[str, Any]) -> str:
        app_id = str(uuid.uuid4())[:8]
        self.apps[app_id] = {
            "id": app_id,
            "user_id": user_id,
            "name": app_data["name"],
            "filename": app_data.get("filename", ""),
            "url": "",
            "local_port": 0,
            "created_at": datetime.now().isoformat(),
            "status": "stopped",
            "visits": 0,
            "type": app_data.get("type", "python")
        }
        self.save()
        logger.info(f"App added: {app_id} - {app_data['name']}")
        return app_id
    
    def update_app(self, app_id: str, data: Dict[str, Any]):
        if app_id in self.apps:
            self.apps[app_id].update(data)
            self.save()
    
    def get_user_apps(self, user_id: int) -> Dict[str, Dict[str, Any]]:
        return {app_id: app for app_id, app in self.apps.items() if app["user_id"] == user_id}
    
    def get_app(self, app_id: str) -> Optional[Dict[str, Any]]:
        return self.apps.get(app_id)
    
    def delete_app(self, app_id: str) -> bool:
        if app_id in self.apps:
            app_dir = APPS_DIR / app_id
            if app_dir.exists():
                shutil.rmtree(app_dir)
            del self.apps[app_id]
            self.save()
            return True
        return False
    
    def get_all_apps(self):
        return self.apps

