    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();
        tg.setHeaderColor('#1a1a1a');
        tg.setBackgroundColor('#1a1a1a');

        let userId = tg.initDataUnsafe?.user?.id || 123456789;
        let userData = null;
        let gameState = null;
        let selectedMines = 1;

        // Загрузка данных пользователя
        async function loadUserData() {
            try {
                const response = await fetch(`/api/user/${userId}`);
                userData = await response.json();
                updateBalanceDisplay();
                updateHistory();
            } catch (error) {
                console.error('Error loading user data:', error);
            }
        }

        function updateBalanceDisplay() {
            if (userData) {
                document.getElementById('balance').textContent = userData.balance;
                document.getElementById('modalBalance').textContent = userData.balance;
            }
        }

        // Навигация
        function showMainScreen() {
            document.getElementById('mainScreen').style.display = 'block';
            document.getElementById('minesGame').style.display = 'none';
            document.getElementById('gameBoard').style.display = 'none';
            document.getElementById('profileScreen').style.display = 'none';
            
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            document.querySelectorAll('.nav-item')[0].classList.add('active');
        }

        function showProfile() {
            document.getElementById('mainScreen').style.display = 'none';
            document.getElementById('minesGame').style.display = 'none';
            document.getElementById('gameBoard').style.display = 'none';
            document.getElementById('profileScreen').style.display = 'block';
            
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            document.querySelectorAll('.nav-item')[1].classList.add('active');
            
            updateHistory();
        }

        // Баланс
        function showBalanceMenu() {
            document.getElementById('balanceModal').classList.add('active');
            updateBalanceDisplay();
        }

        function closeBalanceModal() {
            document.getElementById('balanceModal').classList.remove('active');
        }

        function showDepositModal() {
            document.getElementById('balanceModal').classList.remove('active');
            document.getElementById('depositModal').classList.add('active');
        }

        function closeDepositModal() {
            document.getElementById('depositModal').classList.remove('active');
        }

        function showWithdrawModal() {
            document.getElementById('balanceModal').classList.remove('active');
            document.getElementById('withdrawModal').classList.add('active');
        }

        function closeWithdrawModal() {
            document.getElementById('withdrawModal').classList.remove('active');
        }

        function copyModerator() {
            navigator.clipboard.writeText('@ForceGames_Moders');
            tg.showPopup({
                title: 'Скопировано!',
                message: 'Ник модератора скопирован в буфер обмена'
            });
        }

        async function requestWithdraw() {
            const amount = parseInt(document.getElementById('withdrawAmount').value);
            
            if (amount < 100) {
                tg.showPopup({
                    title: 'Ошибка',
                    message: 'Минимальная сумма вывода: 100 ⭐'
                });
                return;
            }

            if (userData.balance < amount) {
                tg.showPopup({
                    title: 'Ошибка',
                    message: 'Недостаточно средств'
                });
                return;
            }

            tg.showPopup({
                title: 'Запрос отправлен',
                message: `Запрос на вывод ${amount} ⭐ отправлен. Ожидайте обработки.`
            });
            
            closeWithdrawModal();
        }

        // Игра Мины
        function startMinesGame() {
            document.getElementById('mainScreen').style.display = 'none';
            document.getElementById('minesGame').style.display = 'block';
            
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
        }

        function backToMain() {
            showMainScreen();
        }

        // Выбор мин
        document.getElementById('minesSelection').addEventListener('click', function(e) {
            if (e.target.classList.contains('mine-option')) {
                document.querySelectorAll('.mine-option').forEach(el => el.classList.remove('selected'));
                e.target.classList.add('selected');
                selectedMines = parseInt(e.target.dataset.mines);
                
                const multipliers = {1: 1.5, 3: 3.0, 5: 5.0, 10: 10.0};
                document.getElementById('multiplierInfo').textContent = 
                    `Множитель: x${multipliers[selectedMines]}`;
            }
        });

        function startGame() {
            const bet = parseInt(document.getElementById('betAmount').value);
            
            if (bet < 10) {
                tg.showPopup({
                    title: 'Ошибка',
                    message: 'Минимальная ставка: 10 ⭐'
                });
                return;
            }

            if (userData.balance < bet) {
                tg.showPopup({
                    title: 'Ошибка',
                    message: 'Недостаточно средств на балансе'
                });
                return;
            }

            // Инициализация игры
            gameState = {
                bet: bet,
                mines: selectedMines,
                revealed: 0,
                board: [],
                gameOver: false,
                multiplier: 1,
                currentWin: 0
            };

            // Создаем поле 5x5
            const totalCells = 25;
            const minePositions = new Set();
            
            while (minePositions.size < selectedMines) {
                minePositions.add(Math.floor(Math.random() * totalCells));
            }

            for (let i = 0; i < totalCells; i++) {
                gameState.board.push({
                    hasMine: minePositions.has(i),
                    revealed: false
                });
            }

            // Списываем ставку
            userData.balance -= bet;
            updateBalanceDisplay();

            // Показываем игровое поле
            document.getElementById('minesGame').style.display = 'none';
            document.getElementById('gameBoard').style.display = 'block';
            document.getElementById('currentBet').textContent = bet + ' ⭐';
            document.getElementById('currentWin').textContent = '0 ⭐';
            
            renderBoard();
        }

        function backToSetup() {
            document.getElementById('gameBoard').style.display = 'none';
            document.getElementById('minesGame').style.display = 'block';
        }

        function renderBoard() {
            const board = document.getElementById('board');
            board.innerHTML = '';
            
            gameState.board.forEach((cell, index) => {
                const cellElement = document.createElement('div');
                cellElement.className = 'cell';
                
                if (cell.revealed) {
                    cellElement.classList.add('revealed');
                    if (cell.hasMine) {
                        cellElement.classList.add('mine');
                        cellElement.textContent = '💣';
                    } else {
                        cellElement.textContent = '💎';
                    }
                }
                
                cellElement.addEventListener('click', () => revealCell(index));
                board.appendChild(cellElement);
            });
        }

        function revealCell(index) {
            if (gameState.gameOver || gameState.board[index].revealed) return;
            
            gameState.board[index].revealed = true;
            gameState.revealed++;
            
            if (gameState.board[index].hasMine) {
                // Проигрыш
                gameState.gameOver = true;
                gameState.board.forEach(cell => {
                    if (cell.hasMine) cell.revealed = true;
                });
                renderBoard();
                
                // Сохраняем историю
                saveGameHistory('loss', -gameState.bet);
                
                setTimeout(() => {
                    tg.showPopup({
                        title: 'Проигрыш!',
                        message: `Вы наткнулись на мину и потеряли ${gameState.bet} ⭐`
                    });
                }, 500);
            } else {
                // Расчет выигрыша
                const multipliers = {1: 1.5, 3: 3.0, 5: 5.0, 10: 10.0};
                const baseMultiplier = multipliers[gameState.mines];
                gameState.multiplier = baseMultiplier * (1 + (gameState.revealed * 0.1));
                gameState.currentWin = Math.floor(gameState.bet * gameState.multiplier);
                
                document.getElementById('currentWin').textContent = gameState.currentWin + ' ⭐';
                renderBoard();
            }
        }

        function cashOut() {
            if (gameState.gameOver || gameState.revealed === 0) return;
            
            const winAmount = gameState.currentWin;
            userData.balance += winAmount;
            updateBalanceDisplay();
            
            // Сохраняем историю
            saveGameHistory('win', winAmount);
            
            gameState.gameOver = true;
            
            // Показываем все мины
            gameState.board.forEach(cell => {
                if (cell.hasMine) cell.revealed = true;
            });
            renderBoard();
            
            setTimeout(() => {
                tg.showPopup({
                    title: 'Победа!',
                    message: `Вы выиграли ${winAmount} ⭐!`
                });
                document.getElementById('gameBoard').style.display = 'none';
                document.getElementById('mainScreen').style.display = 'block';
            }, 1000);
        }

        async function saveGameHistory(result, profit) {
            try {
                await fetch(`/api/user/${userId}/history`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        game: 'mines',
                        bet: gameState.bet,
                        mines: gameState.mines,
                        result: result,
                        profit: profit
                    })
                });
            } catch (error) {
                console.error('Error saving history:', error);
            }
            
            // Обновляем баланс на сервере
            try {
                await fetch(`/api/user/${userId}/balance`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({balance: userData.balance})
                });
            } catch (error) {
                console.error('Error updating balance:', error);
            }
        }

        function updateHistory() {
            const container = document.getElementById('historyContainer');
            if (!userData || !userData.game_history || userData.game_history.length === 0) {
                container.innerHTML = '<p style="text-align: center; opacity: 0.6;">Пока нет игр</p>';
                return;
            }
            
            container.innerHTML = userData.game_history.slice().reverse().map(game => `
                <div class="history-item ${game.result}">
                    <div>
                        <div><strong>💣 Мины</strong></div>
                        <div style="font-size: 12px;">${new Date(game.timestamp).toLocaleString()}</div>
                        <div style="font-size: 12px;">Ставка: ${game.bet} ⭐ | Мин: ${game.mines}</div>
                    </div>
                    <div style="font-size: 18px; font-weight: 700;">
                        ${game.result === 'win' ? '+' + game.profit : game.profit} ⭐
                    </div>
                </div>
            `).join('');
        }

        // Инициализация
        loadUserData();
    </script>
</body>
</html>
'''

