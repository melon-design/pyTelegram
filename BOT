import asyncio
import logging
import os

from aiogram import Bot, Dispatcher, Router, F
from aiogram.types import (
    Message,
    CallbackQuery,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
)
from aiogram.filters import CommandStart

# Настройка логирования
logging.basicConfig(level=logging.INFO)

# Токен берётся из переменной окружения BOT_TOKEN
TOKEN = os.getenv("8363536613:AAF0XgbP7wF_6KGbd07hzK5t2CFIWoGC_-0")
if not TOKEN:
    raise ValueError("Переменная окружения BOT_TOKEN не установлена!")

# Инициализация бота, диспетчера и роутера
bot = Bot(token=TOKEN)
dp = Dispatcher()
router = Router()

# Текст, показываемый при старте (и возврате в главное меню)
START_TEXT = (
    "Приветствую, в нашем боте.\n\n"
    "Обезательно:\n"
    "Пользуясь нашим ботом вы автоматически соглашаетесь с "
    "Политикой Конфидициальности, и Условиями Использования.\n\n"
    "Выберите действие:"
)

# ---------- Клавиатуры ----------
def main_menu_keyboard() -> InlineKeyboardMarkup:
    """Главное меню: слева «Создать», справа «Кабинет» на верхнем ряду,
    ниже – «Информация»."""
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text="🔔 Создать", callback_data="create"),
                InlineKeyboardButton(text="💼 Кабинет", callback_data="cabinet"),
            ],
            [
                InlineKeyboardButton(text="📰 Информация", callback_data="info"),
            ],
        ]
    )

def cabinet_menu_keyboard() -> InlineKeyboardMarkup:
    """Клавиатура раздела «Кабинет»."""
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [InlineKeyboardButton(text="📜 Мой список", callback_data="my_list")],
            [InlineKeyboardButton(text="🏛️ Настройки", callback_data="settings")],
            [InlineKeyboardButton(text="⬅️ Назад", callback_data="back_to_main")],
        ]
    )

def create_menu_keyboard() -> InlineKeyboardMarkup:
    """Клавиатура раздела «Создать»."""
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [InlineKeyboardButton(text="🎲 Розыгрыш", callback_data="giveaway")],
            [InlineKeyboardButton(text="🎮 Мины", callback_data="mines")],
            [InlineKeyboardButton(text="⬅️ Назад", callback_data="back_to_main")],
        ]
    )

def back_keyboard() -> InlineKeyboardMarkup:
    """Простая клавиатура с кнопкой «Назад»."""
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [InlineKeyboardButton(text="⬅️ Назад", callback_data="back_to_main")],
        ]
    )

# ---------- Обработчики команд ----------
@router.message(CommandStart())
async def cmd_start(message: Message):
    """Отправляет приветственное сообщение с главным меню."""
    await message.answer(START_TEXT, reply_markup=main_menu_keyboard())

# ---------- Обработчики инлайн-кнопок ----------
@router.callback_query(F.data == "cabinet")
async def show_cabinet(callback: CallbackQuery):
    """Показывает кабинет: username и id пользователя."""
    user = callback.from_user
    username = f"@{user.username}" if user.username else "не задан"
    text = f"💠 {username}\n🆔 {user.id}"
    await callback.message.edit_text(text, reply_markup=cabinet_menu_keyboard())
    await callback.answer()

@router.callback_query(F.data == "my_list")
async def show_my_list(callback: CallbackQuery):
    """Показывает список созданных розыгрышей, конкурсов и т.п."""
    text = (
        "📜 Мой список:\n"
        "Показывает список твоих уже созданных розыгрышей, конкурсов и "
        "всего подобного.\n\n"
        "Сначала просто список, но потом в обновлении добавлю более "
        "детальный список и информацию о созданных."
    )
    await callback.message.edit_text(text, reply_markup=back_keyboard())
    await callback.answer()

@router.callback_query(F.data == "settings")
async def show_settings(callback: CallbackQuery):
    """Настройки (coming soon)."""
    await callback.message.edit_text("🏛️ Настройки\nComing Soon...", reply_markup=back_keyboard())
    await callback.answer()

@router.callback_query(F.data == "create")
async def show_create(callback: CallbackQuery):
    """Раздел «Создать»."""
    text = "🔔 Создать\nComing Soon..."
    await callback.message.edit_text(text, reply_markup=create_menu_keyboard())
    await callback.answer()

@router.callback_query(F.data == "giveaway")
async def show_giveaway(callback: CallbackQuery):
    """Розыгрыш (coming soon)."""
    await callback.message.edit_text("🎲 Розыгрыш\nComing Soon...", reply_markup=back_keyboard())
    await callback.answer()

@router.callback_query(F.data == "mines")
async def show_mines(callback: CallbackQuery):
    """Мины (coming soon)."""
    await callback.message.edit_text("🎮 Мины\nComing Soon...", reply_markup=back_keyboard())
    await callback.answer()

@router.callback_query(F.data == "info")
async def show_info(callback: CallbackQuery):
    """Информация (coming soon)."""
    await callback.message.edit_text("📰 Информация\nComing Soon...", reply_markup=back_keyboard())
    await callback.answer()

@router.callback_query(F.data == "back_to_main")
async def back_to_main(callback: CallbackQuery):
    """Возврат в главное меню."""
    await callback.message.edit_text(START_TEXT, reply_markup=main_menu_keyboard())
    await callback.answer()

# ---------- Запуск ----------
async def main():
    dp.include_router(router)
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
