            f"📱 <b>Мои приложения</b> ({len(apps)})\nВыберите:",
            reply_markup=apps_keyboard(apps)
        )
    await callback.answer()

@dp.callback_query(F.data.startswith("menu_"))
async def show_app_menu(callback: types.CallbackQuery):
    app_id = callback.data.replace("menu_", "")
    app = db.get_app(app_id)
    
    if not app:
        await callback.answer("Не найдено", show_alert=True)
        return
    
    is_running = process_manager.is_running(app_id)
    proc = process_manager.get_process(app_id)
    
    stats = ""
    if proc and is_running:
        s = proc.get_stats()
        stats = f"💻 CPU: {s['cpu']:.1f}% | 💾 RAM: {s['memory_mb']:.1f}MB\n"
    
    await callback.message.edit_text(
        f"📱 <b>{app['name']}</b>\n\n"
        f"📄 {app['filename']}\n"
        f"🔌 Порт: {app.get('local_port', 'N/A')}\n"
        f"🔗 <code>{app.get('url', 'Не запущено')}</code>\n"
        f"📊 {'🟢 Работает' if is_running else '🔴 Остановлено'}\n"
        f"{stats}"
        f"👁 Посещений: {app.get('visits', 0)}",
        reply_markup=app_menu_keyboard(app_id)
    )
    await callback.answer()

@dp.callback_query(F.data.startswith("toggle_"))
async def toggle_app(callback: types.CallbackQuery):
    app_id = callback.data.replace("toggle_", "")
    
    try:
        if process_manager.is_running(app_id):
            tunnel_manager.stop_tunnel(app_id)
            process_manager.stop_app(app_id)
            await callback.answer("⏹ Остановлено", show_alert=True)
        else:
            port = process_manager.start_app(app_id)
            url = tunnel_manager.create_tunnel(app_id, port)
            await callback.answer(f"▶️ Запущено!\n{url}", show_alert=True)
        
        await show_app_menu(callback)
    except Exception as e:
        await callback.answer(f"❌ {e}", show_alert=True)

@dp.callback_query(F.data.startswith("restart_"))
async def restart_app(callback: types.CallbackQuery):
    app_id = callback.data.replace("restart_", "")
    
    try:
        if process_manager.is_running(app_id):
            tunnel_manager.stop_tunnel(app_id)
            process_manager.stop_app(app_id)
        
        port = process_manager.start_app(app_id)
        url = tunnel_manager.create_tunnel(app_id, port)
        
        await callback.message.edit_text(
            f"✅ Перезапущено!\n🔗 <code>{url}</code>",
            reply_markup=app_menu_keyboard(app_id)
        )
    except Exception as e:
        await callback.message.edit_text(
            f"❌ Ошибка: {e}",
            reply_markup=main_keyboard()
        )
    
    await callback.answer()

@dp.callback_query(F.data.startswith("delete_"))
async def delete_app(callback: types.CallbackQuery):
    app_id = callback.data.replace("delete_", "")
    
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✅ Да", callback_data=f"confirm_delete_{app_id}"),
         InlineKeyboardButton(text="❌ Нет", callback_data=f"menu_{app_id}")]
    ])
    
    await callback.message.edit_text(
        "⚠️ Удалить приложение?",
        reply_markup=keyboard
    )
