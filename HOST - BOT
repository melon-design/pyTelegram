    )
    await callback.answer()

# ===================== ЗАПУСК =====================
async def cleanup():
    logger.info("Cleaning up...")
    process_manager.cleanup()
    tunnel_manager.cleanup()

async def main():
    logger.info("Starting Mini App Hosting Bot...")
    
    # Восстановление туннелей для запущенных приложений
    for app_id, app in db.get_all_apps().items():
        if app["status"] == "running":
            try:
                process_manager.start_app(app_id)
                tunnel_manager.create_tunnel(app_id, app["local_port"])
            except:
                pass
    
    try:
        await bot.delete_webhook(drop_pending_updates=True)
        await dp.start_polling(bot)
    finally:
        await cleanup()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("Bot stopped")
    except Exception as e:
        logger.error(f"Fatal error: {e}")
