class AppProcess:
    def __init__(self, app_id: str, port: int, process: subprocess.Popen):
        self.app_id = app_id
        self.port = port
        self.process = process
        self.start_time = datetime.now()
    
    def is_running(self) -> bool:
        return self.process and self.process.poll() is None
    
    def stop(self):
        if self.process:
            try:
                self.process.terminate()
                self.process.wait(timeout=5)
            except:
                self.process.kill()
            
            try:
                parent = psutil.Process(self.process.pid)
                for child in parent.children(recursive=True):
                    child.kill()
            except:
                pass
    
    def get_stats(self) -> Dict[str, Any]:
        try:
            proc = psutil.Process(self.process.pid)
            return {
                "cpu": proc.cpu_percent(),
                "memory_mb": proc.memory_info().rss / 1024 / 1024,
                "uptime": (datetime.now() - self.start_time).total_seconds(),
                "status": "running" if self.is_running() else "stopped"
            }
        except:
            return {"status": "stopped"}

class ProcessManager:
    def __init__(self):
        self.processes: Dict[str, AppProcess] = {}
        self.next_port = 9000
    
    def start_app(self, app_id: str) -> int:
        app = db.get_app(app_id)
        if not app:
            raise ValueError("App not found")
        
        app_dir = APPS_DIR / app_id
        app_file = app_dir / app["filename"]
        
        if not app_file.exists():
            raise FileNotFoundError(f"File not found: {app_file}")
        
        port = self.next_port
        self.next_port += 1
        
        env = os.environ.copy()
        env["PORT"] = str(port)
        env["APP_ID"] = app_id
        
        try:
            process = subprocess.Popen(
                [sys.executable, str(app_file)],
                cwd=str(app_dir),
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            time.sleep(2)
            
            if process.poll() is not None:
                _, stderr = process.communicate()
                raise RuntimeError(f"Process failed: {stderr}")
            
            self.processes[app_id] = AppProcess(app_id, port, process)
            db.update_app(app_id, {"local_port": port, "status": "running"})
            logger.info(f"App {app_id} started on port {port}")
            return port
            
        except Exception as e:
            logger.error(f"Failed to start app {app_id}: {e}")
            raise
    
    def stop_app(self, app_id: str):
        if app_id in self.processes:
            self.processes[app_id].stop()
            del self.processes[app_id]
            db.update_app(app_id, {"status": "stopped"})
    
    def is_running(self, app_id: str) -> bool:
        return app_id in self.processes and self.processes[app_id].is_running()
    
    def get_process(self, app_id: str) -> Optional[AppProcess]:
        return self.processes.get(app_id)
    
    def cleanup(self):
        for app_id in list(self.processes.keys()):
            self.stop_app(app_id)

process_manager = ProcessManager()

