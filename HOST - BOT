@dp.callback_query(F.data.startswith("confirm_delete_"))
async def confirm_delete(callback: types.CallbackQuery):
    app_id = callback.data.replace("confirm_delete_", "")
    
    tunnel_manager.stop_tunnel(app_id)
    process_manager.stop_app(app_id)
