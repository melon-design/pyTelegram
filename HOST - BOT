class TunnelManager:
    def __init__(self):
        self.tunnels: Dict[str, Dict[str, Any]] = {}
    
    def create_tunnel(self, app_id: str, port: int) -> str:
        try:
            # Пробуем через localhost.run (не требует регистрации)
            public_url = self._try_localhost_run(port)
            if not public_url:
                # Пробуем через serveo.net
                public_url = self._try_serveo(port)
            if not public_url:
                # Пробуем через ngrok если установлен
                public_url = self._try_ngrok(app_id, port)
            
            if not public_url:
                raise Exception("No tunnel available")
            
            db.update_app(app_id, {"url": public_url})
            logger.info(f"Tunnel created for {app_id}: {public_url}")
            return public_url
            
        except Exception as e:
            logger.error(f"Tunnel creation failed: {e}")
            raise
    
    def _try_localhost_run(self, port: int) -> Optional[str]:
        try:
            cmd = f"ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=60 -R 80:localhost:{port} nokey@localhost.run"
            process = subprocess.Popen(
                cmd.split(),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            time.sleep(3)
            output = ""
            for _ in range(15):
                line = process.stdout.readline()
                if line:
                    output += line
                    match = re.search(r'https://[a-zA-Z0-9\-]+\.lhr\.life', output)
                    if match:
                        self.tunnels[app_id] = {'process': process, 'url': match.group(0)}
                        return match.group(0)
                time.sleep(1)
            
            process.kill()
            return None
        except:
            return None
    
    def _try_serveo(self, port: int) -> Optional[str]:
        try:
            cmd = f"ssh -o StrictHostKeyChecking=no -R 80:localhost:{port} serveo.net"
            process = subprocess.Popen(
                cmd.split(),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            time.sleep(3)
            output = ""
            for _ in range(15):
                line = process.stdout.readline()
                if line:
                    output += line
                    match = re.search(r'https://[a-zA-Z0-9]+\.serveo\.net', output)
                    if match:
                        self.tunnels[app_id] = {'process': process, 'url': match.group(0)}
                        return match.group(0)
                time.sleep(1)
            
            process.kill()
            return None
        except:
            return None
    
    def _try_ngrok(self, app_id: str, port: int) -> Optional[str]:
        if not shutil.which('ngrok'):
            return None
        
        try:
            process = subprocess.Popen(
                ['ngrok', 'http', str(port), '--log=stdout'],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            time.sleep(2)
            response = requests.get('http://localhost:4040/api/tunnels')
            tunnels_data = response.json()
            
            for tunnel in tunnels_data['tunnels']:
                if str(port) in tunnel['config']['addr']:
                    url = tunnel['public_url']
                    self.tunnels[app_id] = {'process': process, 'url': url}
                    return url
            
            process.kill()
            return None
        except:
            return None
    
    def stop_tunnel(self, app_id: str):
        if app_id in self.tunnels:
            try:
                self.tunnels[app_id]['process'].terminate()
                self.tunnels[app_id]['process'].wait(timeout=5)
            except:
                self.tunnels[app_id]['process'].kill()
            del self.tunnels[app_id]
    
    def cleanup(self):
        for app_id in list(self.tunnels.keys()):
            self.stop_tunnel(app_id)

tunnel_manager = TunnelManager()

