@dp.message(AppCreation.waiting_for_file, F.document)
async def process_python(message: Message, state: FSMContext):
    doc = message.document
    
    if not doc.file_name.endswith('.py'):
        await message.answer("❌ Только .py файлы!")
        return
    
    if doc.file_size > 10 * 1024 * 1024:
        await message.answer("❌ Максимальный размер: 10 МБ")
        return
    
    status = await message.answer("📥 Скачиваю файл...")
    
    try:
        file = await bot.get_file(doc.file_id)
        file_bytes = await bot.download_file(file.file_path)
        code = file_bytes.read().decode('utf-8')
        
        # Проверка безопасности
        dangerous = ['os.system', 'subprocess.call', 'eval(', 'exec(', '__import__', 'compile(']
        for d in dangerous:
            if d in code:
                await status.edit_text(f"⚠️ Опасный код: {d}")
                await state.clear()
                return
        
        temp_dir = APPS_DIR / "temp" / str(message.from_user.id) / str(uuid.uuid4())[:8]
        temp_dir.mkdir(parents=True, exist_ok=True)
        
        with open(temp_dir / doc.file_name, 'w', encoding='utf-8') as f:
            f.write(code)
        
        await state.update_data(temp_dir=str(temp_dir), filename=doc.file_name)
        await status.edit_text("✅ Файл проверен!\nВведите название:")
        await state.set_state(AppCreation.waiting_for_name)
        
    except Exception as e:
        await status.edit_text(f"❌ Ошибка: {e}")
        await state.clear()

