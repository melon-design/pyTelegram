@dp.message(lambda message: message.document and message.document.file_name.endswith('.py'))
async def handle_py_file(message: types.Message):
    """Обработка загруженного .py файла"""
    user_id = message.from_user.id
    
    # Останавливаем старую сессию
    if user_id in sessions:
        await stop_session(user_id)
    
    await message.answer("⏳ Загрузка и запуск скрипта...")
    
    try:
        # Скачиваем файл
        file = await bot.get_file(message.document.file_id)
        file_content = await bot.download_file(file.file_path)
        code = file_content.read().decode('utf-8')
        
        # Сохраняем во временный файл
        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False, encoding='utf-8') as f:
            f.write(code)
            temp_file = f.name
        
        # Запускаем скрипт с возможностью ввода
        proc = await asyncio.create_subprocess_exec(
            'python', '-u', temp_file,  # -u для unbuffered вывода
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            stdin=subprocess.PIPE
        )
        
        # Создаем сессию
        session = UserBotSession(user_id, proc, temp_file)
        sessions[user_id] = session
        
        # Запускаем мониторинг вывода
        asyncio.create_task(monitor_output(session))
        
        # Запускаем обработчик ввода из Telegram
        asyncio.create_task(handle_telegram_input(session))
        
        await message.answer(
            f"✅ **Скрипт успешно запущен!**\n\n"
            f"📁 Файл: {message.document.file_name}\n"
            f"🆔 PID: {proc.pid}\n"
            f"📟 Для просмотра консоли: /console\n"
            f"⌨️ Если бот запросит код - просто отправьте его в чат",
            parse_mode="Markdown"
        )
        
        # Сохраняем сессию
        save_session(user_id)
        
    except Exception as e:
        await message.answer(f"❌ Ошибка: {str(e)}")

async def monitor_output(session):
    """Мониторинг вывода скрипта"""
    proc = session.process
    
    while session.is_running:
        try:
            # Читаем вывод построчно с таймаутом
            line = await asyncio.wait_for(
                proc.stdout.readline(), 
                timeout=0.1
            )
            
            if not line:
                # Проверяем, не завершился ли процесс
                if proc.poll() is not None:
                    session.is_running = False
                    break
                continue
            
            decoded_line = line.decode('utf-8', errors='ignore').strip()
            
            if decoded_line:
                # Сохраняем в историю
                session.output_lines.append(decoded_line)
                if len(session.output_lines) > 1000:
                    session.output_lines = session.output_lines[-1000:]
                
                session.last_activity = datetime.now()
                
                # Логируем для отладки
                logging.info(f"[{session.user_id}] {decoded_line}")
                
                # Проверяем, запрашивает ли скрипт ввод
                input_keywords = ['введите', 'enter', 'code', 'код', 'подтверждение', 'captcha']
                if any(keyword in decoded_line.lower() for keyword in input_keywords):
                    session.waiting_for_input = True
                    # Отправляем уведомление пользователю
                    await bot.send_message(
                        session.user_id,
                        f"⌨️ **Запрос ввода от скрипта:**\n\n"
                        f"```\n{decoded_line[:200]}\n```\n\n"
                        f"Отправьте ответ в этот чат",
                        parse_mode="Markdown"
                    )
                
        except asyncio.TimeoutError:
            continue
        except Exception as e:
            logging.error(f"Ошибка мониторинга: {e}")
            break
    
    # Очистка при завершении
    if session.user_id in sessions:
        save_session(session.user_id)

async def handle_telegram_input(session):
    """Обработка ввода из Telegram"""
    while session.is_running:
        try:
            # Ждем сообщение от пользователя
            @dp.message()
            async def handle_message(message: types.Message):
                if message.from_user.id != session.user_id:
                    return
                
                # Проверяем, ожидает ли скрипт ввод
                if session.waiting_for_input:
                    # Отправляем ввод в скрипт
                    success = await session.send_input(message.text)
                    if success:
                        session.waiting_for_input = False
                        await message.answer("✅ Ввод отправлен в скрипт")
                    else:
                        await message.answer("❌ Не удалось отправить ввод")
                
                # Если скрипт не ожидает ввод, но пользователь что-то пишет
                elif message.text and not message.text.startswith('/'):
                    await message.answer(
                        "ℹ️ Скрипт не ожидает ввода\n"
                        "Если нужно отправить данные, используйте команды\n"
                        "или дождитесь запроса от скрипта"
                    )
            
            await asyncio.sleep(1)
            
        except Exception as e:
            logging.error(f"Ошибка ввода: {e}")
            await asyncio.sleep(1)

