import telebot
from telebot import types
import os
import subprocess
import sys
import time

# ================= НАСТРОЙКИ =================
TOKEN = '8001099846:AAEpC_DtgBiXC42tcu9XUQZUuBOgiRk2DfE'
ADMIN_ID = 8893906363 

bot = telebot.TeleBot(TOKEN)
HOSTING_DIR = "hosted_scripts"
SCRIPT_NAME = "user_script.py"
SCRIPT_PATH = os.path.join(HOSTING_DIR, SCRIPT_NAME)
LOG_PATH = os.path.join(HOSTING_DIR, "error.log")  # Файл для отлова ошибок

current_process = None

if not os.path.exists(HOSTING_DIR):
    os.makedirs(HOSTING_DIR)

def get_main_keyboard():
    keyboard = types.InlineKeyboardMarkup()
    keyboard.add(types.InlineKeyboardButton(text="🗑 Удалить и остановить", callback_data="delete_all"))
    return keyboard

def stop_and_clean():
    global current_process
    if current_process and current_process.poll() is None:
        current_process.terminate()
        current_process.wait()
        current_process = None
    
    if os.path.exists(SCRIPT_PATH):
        os.remove(SCRIPT_PATH)
    if os.path.exists(LOG_PATH):
        os.remove(LOG_PATH)

@bot.message_handler(commands=['start'])
def start(message):
    if message.chat.id != ADMIN_ID: return
    bot.send_message(message.chat.id, "🤖 Хостинг готов.\nПросто отправь мне `.py` файл, и он запустится автоматически!")

@bot.callback_query_handler(func=lambda call: call.data == "delete_all")
def delete_all(call):
    stop_and_clean()
    bot.answer_callback_query(call.id, "🛑 Скрипт остановлен и удален.")
    bot.edit_message_text("🗑 Хостинг пуст. Жду новый файл.", call.message.chat.id, call.message.message_id)

@bot.message_handler(content_types=['document'])
def handle_docs(message):
    global current_process
    if message.chat.id != ADMIN_ID: return

    if not message.document.file_name.endswith('.py'):
        bot.reply_to(message, "❌ Только .py файлы!")
        return

    # Чистим старое
    stop_and_clean()

    # Сохраняем новый файл
    file_info = bot.get_file(message.document.file_id)
    downloaded_file = bot.download_file(file_info.file_path)
    with open(SCRIPT_PATH, 'wb') as new_file:
        new_file.write(downloaded_file)

    # Открываем лог-файл для записи ошибок скрипта
    log_file = open(LOG_PATH, "w")

    try:
        # Запускаем и перенаправляем поток ошибок (stderr) в файл
        current_process = subprocess.Popen(
            [sys.executable, SCRIPT_PATH],
            stderr=log_file,
            stdout=log_file
        )
        
        # Даем скрипту 2 секунды опомниться и проверяем, не сдох ли он на старте
        time.sleep(2)
        log_file.close() # Закрываем, чтобы прочитать, если что-то записалось

        if current_process.poll() is not None:
            # Если процесс завершился (poll() не None), значит он упал с ошибкой
            with open(LOG_PATH, "r") as f:
                error_text = f.read()
            
            bot.reply_to(message, f"❌ Скрипт упал сразу после запуска!\n\n**Лог ошибки:**\n```\n{error_text[-3000:]}\n```", parse_mode="Markdown")
            stop_and_clean()
        else:
            bot.reply_to(message, "✅ Файл загружен и успешно запущен 24/7!", reply_markup=get_main_keyboard())

    except Exception as e:
        bot.reply_to(message, f"❌ Системная ошибка запуска: {e}")

if __name__ == '__main__':
    bot.infinity_polling()
