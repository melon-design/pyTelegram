    Обработчик всех остальных сообщений
    Предлагает пользователю открыть Mini App
    """
    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="🚀 Открыть Mini App",
                    web_app=WebAppInfo(url=MINI_APP_URL)
                )
