        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="🚀 Открыть Mini App",
                    web_app=WebAppInfo(url=MINI_APP_URL)
                )
            ],
            [
                InlineKeyboardButton(
                    text="📢 Наш канал",
                    url="https://t.me/your_channel"  # Замените на свой канал
                )
            ]
        ]
    )
    
    # Приветственный текст
    welcome_text = f"""
👋 <b>Привет, {message.from_user.full_name}!</b>

Добро пожаловать в нашего бота! 🎉

Нажми на кнопку ниже, чтобы открыть Mini App:

🔹 <b>Что внутри:</b>
