@dp.callback_query(lambda c: c.data == "tower_build")
async def tower_build(callback: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    floors = data.get("floors", 3)
    multiplier = data.get("multiplier", 2)
    current_floor = data.get("current_floor", 0)
    bet = data.get("bet", 0)
    user_id = callback.from_user.id
    
    if bet == 0:
        await callback.answer("❌ Ошибка", show_alert=True)
        return
    
    current_floor += 1
    risk = 0.1 + (current_floor - 1) * 0.02
    
    if random.random() < risk:
        update_balance(user_id, -bet)
        add_history(user_id, "🏗️ Башня", -bet, f"Упал на {current_floor} этаже")
        await callback.message.edit_text(
            f"🏗️ *Башня*\n💥 Рухнула на {current_floor} этаже!\n❌ -{bet} Divine",
            reply_markup=casino_menu(),
            parse_mode="Markdown"
        )
        await state.clear()
        delete_game_bet(user_id)
        await callback.answer()
        return
    
    if current_floor >= floors:
        win = bet * multiplier
        update_balance(user_id, win)
        add_history(user_id, "🏗️ Башня", win, f"Построил {floors} этажей")
        await callback.message.edit_text(
            f"🏗️ *Башня*\n✅ Построил {floors} этажей!\n🎉 +{win} Divine (x{multiplier})",
            reply_markup=casino_menu(),
            parse_mode="Markdown"
        )
        await state.clear()
        delete_game_bet(user_id)
        await callback.answer()
        return
    
    current_multiplier = 1 + (current_floor - 1) * 0.5
    await state.update_data(current_floor=current_floor)
    
    await callback.message.edit_text(
        f"🏗️ *Башня ({floors} этажей, x{multiplier})*\n"
        f"Ставка: *{bet} Divine*\nЭтаж: {current_floor}/{floors}\n"
        f"Множитель: x{current_multiplier:.1f}\n\nСтрой или забери:",
        reply_markup=tower_buttons(current_floor, floors),
        parse_mode="Markdown"
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data == "tower_cashout")
async def tower_cashout(callback: CallbackQuery, state: FSMContext):
