@dp.callback_query(lambda c: c.data.startswith("mines_cell_"))
async def mines_cell(callback: CallbackQuery, state: FSMContext):
    cell = int(callback.data.split("_")[2])
    user_id = callback.from_user.id
    data = await state.get_data()
    
    mines = data.get("mines", 3)
    multiplier = data.get("multiplier", 2)
    bet = data.get("bet", 0)
    field = data.get("field", [["⬜" for _ in range(5)] for _ in range(5)])
    
    if bet == 0:
        await callback.answer("❌ Ошибка. Начни заново.", show_alert=True)
        return
    
    # Генерируем мины
    mine_positions = set()
    while len(mine_positions) < mines:
        pos = random.randint(0, 24)
        if pos != cell:
            mine_positions.add(pos)
    
    row, col = divmod(cell, 5)
    
    if cell in mine_positions:
        field[row][col] = "💣"
        field_str = "\n".join(["".join(row) for row in field])
        update_balance(user_id, -bet)
        add_history(user_id, "💣 Мины", -bet, f"Проигрыш (x{multiplier})")
        await callback.message.edit_text(
            f"💣 *БАХ!* Ты попал на мину!\n\n`{field_str}`\n\n❌ Проигрыш: *-{bet} Divine*",
            reply_markup=casino_menu(),
            parse_mode="Markdown"
        )
        await state.clear()
        delete_game_bet(user_id)
    else:
        field[row][col] = "✅"
        win = bet * multiplier
        update_balance(user_id, win)
        add_history(user_id, "💣 Мины", win, f"Выигрыш (x{multiplier})")
        field_str = "\n".join(["".join(row) for row in field])
        await callback.message.edit_text(
            f"✅ *Ты выжил!*\n\n`{field_str}`\n\n🎉 Выигрыш: *+{win} Divine* (x{multiplier})",
            reply_markup=casino_menu(),
            parse_mode="Markdown"
        )
        await state.clear()
        delete_game_bet(user_id)
    await callback.answer()

