# ========== ФУНКЦИИ БАЗЫ ==========
def get_user(user_id):
    cursor.execute("SELECT balance, last_bonus FROM users WHERE user_id = ?", (user_id,))
    result = cursor.fetchone()
    if not result:
        cursor.execute("INSERT INTO users (user_id, balance, last_bonus) VALUES (?, 0, NULL)", (user_id,))
        conn.commit()
        return 0, None
    return result

def get_balance(user_id):
    cursor.execute("SELECT balance FROM users WHERE user_id = ?", (user_id,))
    result = cursor.fetchone()
    return result[0] if result else 0

def update_balance(user_id, amount):
    cursor.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (amount, user_id))
    conn.commit()

def set_bonus_date(user_id, date_str):
    cursor.execute("UPDATE users SET last_bonus = ? WHERE user_id = ?", (date_str, user_id))
    conn.commit()

def add_history(user_id, type_, amount, detail):
    date_now = datetime.now().strftime("%d.%m.%Y %H:%M")
    cursor.execute("INSERT INTO history (user_id, type, amount, detail, date) VALUES (?, ?, ?, ?, ?)",
                   (user_id, type_, amount, detail, date_now))
    conn.commit()

def get_history(user_id):
    cursor.execute("SELECT type, amount, detail, date FROM history WHERE user_id = ? ORDER BY id DESC LIMIT 20", (user_id,))
    return cursor.fetchall()

