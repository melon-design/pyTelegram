def save_game_bet(user_id, game, bet):
    date_now = datetime.now().strftime("%d.%m.%Y %H:%M")
    cursor.execute("INSERT OR REPLACE INTO game_bets (user_id, game, bet, date) VALUES (?, ?, ?, ?)",
                   (user_id, game, bet, date_now))
    conn.commit()

def get_game_bet(user_id):
    cursor.execute("SELECT game, bet FROM game_bets WHERE user_id = ?", (user_id,))
    result = cursor.fetchone()
    return {"game": result[0], "bet": result[1]} if result else None

def delete_game_bet(user_id):
    cursor.execute("DELETE FROM game_bets WHERE user_id = ?", (user_id,))
    conn.commit()

