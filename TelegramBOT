# ========== БАЗА ДАННЫХ ==========
conn = sqlite3.connect('divine_bot.db', check_same_thread=False)
cursor = conn.cursor()

cursor.execute('''
CREATE TABLE IF NOT EXISTS users (
    user_id INTEGER PRIMARY KEY,
    balance INTEGER DEFAULT 0,
    last_bonus TEXT
)
''')

cursor.execute('''
CREATE TABLE IF NOT EXISTS history (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER,
    type TEXT,
    amount INTEGER,
    detail TEXT,
    date TEXT
)
''')
conn.commit()

# ========== ФУНКЦИИ БАЗЫ ==========
def get_user(user_id):
    cursor.execute("SELECT balance, last_bonus FROM users WHERE user_id = ?", (user_id,))
    result = cursor.fetchone()
    if not result:
        cursor.execute("INSERT INTO users (user_id, balance, last_bonus) VALUES (?, 0, NULL)", (user_id,))
        conn.commit()
        return 0, None
    return result

def get_balance(user_id):
    cursor.execute("SELECT balance FROM users WHERE user_id = ?", (user_id,))
    result = cursor.fetchone()
    return result[0] if result else 0

def update_balance(user_id, amount):
    cursor.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (amount, user_id))
    conn.commit()

def set_bonus_date(user_id, date_str):
    cursor.execute("UPDATE users SET last_bonus = ? WHERE user_id = ?", (date_str, user_id))
    conn.commit()

def add_history(user_id, type_, amount, detail):
    date_now = datetime.now().strftime("%d.%m.%Y %H:%M")
    cursor.execute("INSERT INTO history (user_id, type, amount, detail, date) VALUES (?, ?, ?, ?, ?)",
                   (user_id, type_, amount, detail, date_now))
    conn.commit()

def get_history(user_id):
    cursor.execute("SELECT type, amount, detail, date FROM history WHERE user_id = ? ORDER BY id DESC LIMIT 20", (user_id,))
    return cursor.fetchall()

# ========== КЛАВИАТУРЫ ==========
def main_menu():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="💸 Перевести", callback_data="transfer")],
        [InlineKeyboardButton(text="📜 История", callback_data="history"), 
         InlineKeyboardButton(text="👤 Профиль", callback_data="profile")]
    ])

def profile_menu():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🎁 Забрать Бонус", callback_data="bonus")],
        [InlineKeyboardButton(text="🔙 Назад", callback_data="back_to_menu")]
    ])

def confirm_menu(recipient_id, amount):
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✅ Подтвердить перевод", callback_data=f"confirm_transfer_{recipient_id}_{amount}")],
        [InlineKeyboardButton(text="❌ Отмена", callback_data="cancel_transfer")]
    ])

# ========== СОСТОЯНИЯ FSM ==========
class TransferStates(StatesGroup):
    waiting_for_amount = State()
    waiting_for_recipient = State()

# ========== ОБРАБОТЧИКИ ==========
@dp.message(Command("start"))
async def start(message: types.Message):
    user_id = message.from_user.id
    get_user(user_id)
    await message.answer(
        "✨ *Добро пожаловать в экосистему DIVINE!* ✨\n\n"
        "💰 Здесь твоя цифровая валюта, которая всегда с тобой.\n"
        "Используй кнопки ниже, чтобы управлять своими средствами.",
        reply_markup=main_menu(),
        parse_mode="Markdown"
    )

@dp.callback_query(lambda c: c.data == "back_to_menu")
async def back_to_menu(callback: CallbackQuery):
    await callback.message.edit_text(
        "🏠 *Главное меню*\n\nВыбери действие:",
        reply_markup=main_menu(),
        parse_mode="Markdown"
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data == "profile")
async def show_profile(callback: CallbackQuery):
    user_id = callback.from_user.id
    balance = get_balance(user_id)
    await callback.message.edit_text(
        f"👤 *Твой профиль*\n\n"
        f"🆔 ID: `{user_id}`\n"
        f"💰 Баланс: *{balance} DIVINE*\n\n"
        f"⬇️ Нажми «Забрать Бонус», чтобы получить 2000 DIVINE ежедневно.",
