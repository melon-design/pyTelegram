@dp.message(TransferStates.waiting_for_amount)
async def process_amount(message: types.Message, state: FSMContext):
    if not message.text.isdigit() or int(message.text) <= 0:
        await message.answer("❌ Введи число > 0:")
        return
    
    amount = int(message.text)
    user_id = message.from_user.id
    balance = get_balance(user_id)
    
    if amount > balance:
        await message.answer(f"❌ Недостаточно. Баланс: {balance} Divine")
        return
    
    await state.update_data(amount=amount)
    await state.set_state(TransferStates.waiting_for_recipient)
    
    await message.answer(
        f"💸 Сумма: *{amount} Divine*\n\nВведи ID получателя:",
        reply_markup=cancel_menu(),
        parse_mode="Markdown"
    )

@dp.message(TransferStates.waiting_for_recipient)
async def process_recipient(message: types.Message, state: FSMContext):
    if not message.text.isdigit():
        await message.answer("❌ ID — только цифры:")
        return
    
    recipient_id = int(message.text)
    sender_id = message.from_user.id
    
    if recipient_id == sender_id:
        await message.answer("❌ Нельзя перевести себе:")
        return
    
    if not get_user(recipient_id):
        await message.answer("❌ Пользователь не найден:")
        return
    
    data = await state.get_data()
    amount = data.get("amount")
    recipient_amount, commission = calculate_transfer(amount)
    
    text = f"📤 *Проверь перевод*\n\n"
    text += f"💸 Сумма: *{amount} Divine*\n"
    text += f"👤 Получатель: `{recipient_id}`\n"
    if commission > 0:
        text += f"📊 Комиссия 2%: *-{commission} Divine*\n"
        text += f"💳 Получит: *{recipient_amount} Divine*"
    
    await message.answer(
        text,
        reply_markup=confirm_menu(recipient_id, amount, commission),
        parse_mode="Markdown"
    )
    await state.clear()

@dp.callback_query(lambda c: c.data.startswith("confirm_transfer_"))
async def confirm_transfer(callback: CallbackQuery):
    _, _, recipient_id, amount = callback.data.split("_")
    recipient_id = int(recipient_id)
    amount = int(amount)
    sender_id = callback.from_user.id
    
    balance = get_balance(sender_id)
    if amount > balance:
        await callback.message.edit_text("❌ Недостаточно средств.", reply_markup=main_menu())
        await callback.answer()
        return
    
    recipient_amount, commission = calculate_transfer(amount)
    
    update_balance(sender_id, -amount)
    update_balance(recipient_id, recipient_amount)
    
    add_history(sender_id, "💸 Исходящий", -amount, f"Перевод {recipient_id}")
    add_history(recipient_id, "💳 Входящий", recipient_amount, f"От {sender_id}")
    
    text = f"✅ *Перевод выполнен!*\n\n"
    text += f"💸 Отправлено: *{amount} Divine*\n"
    text += f"👤 Получатель: `{recipient_id}`\n"
    if commission > 0:
        text += f"📊 Комиссия: *{commission} Divine*\n"
        text += f"💳 Получил: *{recipient_amount} Divine*"
    
    await callback.message.edit_text(text, reply_markup=main_menu(), parse_mode="Markdown")
    await callback.answer("✅ Перевод успешен!", show_alert=True)

