    </style>
</head>
<body>
    <div class="container">
        <div class="avatar" id="avatar"></div>
        <h1 id="userName">Привет!</h1>
        <p class="subtitle" id="userUsername"></p>
        
        <div class="info-card">
            <div class="info-row">
                <span class="label">ID пользователя</span>
                <span class="value" id="userId">-</span>
            </div>
            <div class="info-row">
                <span class="label">Язык</span>
                <span class="value" id="userLang">-</span>
            </div>
            <div class="info-row">
                <span class="label">Платформа</span>
                <span class="value" id="platform">-</span>
            </div>
        </div>
        
        <div class="counter-section">
            <p style="color: var(--tg-theme-hint-color, #999); font-size: 14px;">Счётчик нажатий</p>
            <div class="counter" id="counterValue">0</div>
        </div>
        
        <button class="btn" id="incrementBtn">👍 Увеличить</button>
        
        <div class="btn-row">
            <button class="btn secondary" id="resetBtn">🔄 Сбросить</button>
            <button class="btn secondary" id="shareBtn">📤 Поделиться</button>
        </div>
        
        <button class="btn" id="mainBtn" style="margin-top: 12px; display: none;">🚀 Главная кнопка ТГ</button>
    </div>
    
    <div class="toast" id="toast"></div>

    <script>
        // Инициализация Telegram WebApp
        const tg = window.Telegram.WebApp;
        
        // Сообщаем Telegram, что приложение готово
        tg.ready();
        
        // Настройка цветов темы
        document.documentElement.style.setProperty('--tg-theme-bg-color', tg.themeParams.bg_color || '#ffffff');
        document.documentElement.style.setProperty('--tg-theme-text-color', tg.themeParams.text_color || '#222222');
        document.documentElement.style.setProperty('--tg-theme-hint-color', tg.themeParams.hint_color || '#999999');
        document.documentElement.style.setProperty('--tg-theme-button-color', tg.themeParams.button_color || '#2481cc');
        document.documentElement.style.setProperty('--tg-theme-button-text-color', tg.themeParams.button_text_color || '#ffffff');
        document.documentElement.style.setProperty('--tg-theme-secondary-bg-color', tg.themeParams.secondary_bg_color || '#f0f0f0');
        
        // Отображаем данные пользователя
        const user = tg.initDataUnsafe?.user;
        
        if (user) {
            document.getElementById('userName').textContent = user.first_name + (user.last_name ? ' ' + user.last_name : '');
            document.getElementById('userUsername').textContent = user.username ? '@' + user.username : '';
            document.getElementById('userId').textContent = user.id;
            document.getElementById('userLang').textContent = user.language_code || 'не указан';
            
            // Аватар с инициалами
            const initials = (user.first_name ? user.first_name[0] : '?') + (user.last_name ? user.last_name[0] : '');
            document.getElementById('avatar').textContent = initials.toUpperCase();
        } else {
            // Для тестирования вне Telegram
            document.getElementById('userName').textContent = 'Гость';
            document.getElementById('userId').textContent = 'Не в Telegram';
            document.getElementById('avatar').textContent = '👤';
        }
        
        document.getElementById('platform').textContent = tg.platform || 'unknown';
        
        // Счётчик
        let counter = 0;
        const counterValue = document.getElementById('counterValue');
        const toast = document.getElementById('toast');
        
        function showToast(message) {
            toast.textContent = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2000);
        }
        
        function updateCounter() {
            counterValue.textContent = counter;
            // Отправляем данные на сервер
            fetch('/api/counter', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    counter: counter,
                    user_id: user ? user.id : null
                })
            }).catch(err => console.log('Ошибка синхронизации:', err));
        }
        
        document.getElementById('incrementBtn').addEventListener('click', () => {
            counter++;
            updateCounter();
            // Тактильная обратная связь
            tg.HapticFeedback?.impactOccurred('light');
        });
        
        document.getElementById('resetBtn').addEventListener('click', () => {
            counter = 0;
            updateCounter();
            tg.HapticFeedback?.notificationOccurred('warning');
            showToast('Счётчик сброшен! 🔄');
        });
        
        document.getElementById('shareBtn').addEventListener('click', () => {
            const shareText = `Мой счётчик: ${counter} 🎉`;
            if (tg.openTelegramLink) {
                tg.openTelegramLink(`https://t.me/share/url?url=&text=${encodeURIComponent(shareText)}`);
            } else {
                navigator.clipboard.writeText(shareText).then(() => {
                    showToast('Скопировано в буфер! 📋');
                });
            }
        });
        
        // Главная кнопка Telegram
        const mainBtn = document.getElementById('mainBtn');
        
        if (tg.MainButton) {
            mainBtn.style.display = 'block';
            tg.MainButton.setText('Отправить результат');
            tg.MainButton.show();
            
            tg.MainButton.onClick(() => {
                const data = JSON.stringify({
                    counter: counter,
                    user: user
                });
                tg.sendData(data);
                showToast('Данные отправлены боту! ✅');
            });
            
            // Синхронизация с локальной кнопкой
            mainBtn.addEventListener('click', () => {
                tg.MainButton.click();
            });
        }
        
        // Расширяем на весь экран
        tg.expand();
        
        // Обработка изменений темы
        tg.onEvent('themeChanged', () => {
            document.documentElement.style.setProperty('--tg-theme-bg-color', tg.themeParams.bg_color);
            document.documentElement.style.setProperty('--tg-theme-text-color', tg.themeParams.text_color);
            document.documentElement.style.setProperty('--tg-theme-hint-color', tg.themeParams.hint_color);
            document.documentElement.style.setProperty('--tg-theme-button-color', tg.themeParams.button_color);
            document.documentElement.style.setProperty('--tg-theme-button-text-color', tg.themeParams.button_text_color);
            document.documentElement.style.setProperty('--tg-theme-secondary-bg-color', tg.themeParams.secondary_bg_color);
        });
    </script>
</body>
</html>
'''

@app.route('/')
def index():
    """Главная страница Mini App"""
    return render_template_string(HTML_TEMPLATE)

@app.route('/api/counter', methods=['POST'])
def update_counter():
    """API для сохранения значения счётчика"""
    data = request.get_json()
    if data:
        logger.info(f"Пользователь {data.get('user_id')} обновил счётчик: {data.get('counter')}")
        return jsonify({
            'status': 'ok',
            'counter': data.get('counter'),
            'message': 'Счётчик обновлён'
        })
    return jsonify({'status': 'error', 'message': 'Нет данных'}), 400

@app.route('/health')
def health():
    """Проверка работоспособности"""
    return jsonify({'status': 'ok', 'service': 'Telegram Mini App'})

if __name__ == '__main__':
    # Запускаем сервер
    port = int(os.environ.get('PORT', 5000))
    app.run(
        host='0.0.0.0',
        port=port,
        debug=False  # В продакшене ставьте False
    )
